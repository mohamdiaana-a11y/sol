        if type(_G.Config) ~= "table" then
            _G.Config = {}
        end

        _G.Config.SmokeZoneESP = true
        _G.Config.MolotovZoneESP = true

        local function ensureConfig(key, default)
            if _G.Config[key] == nil then
                _G.Config[key] = default
            end
        end

        ensureConfig("GrenadeESP", false)
        ensureConfig("GrenadeTracers", false)
        ensureConfig("ColoredSmoke", false)
        ensureConfig("NoSmoke", false)
        ensureConfig("SmokeColor", Color3.fromRGB(255, 0, 0))

        local zoneSettings = {
            Smoke = {
                RadiusTrim = 0,
                HeightOffset = 0.3,
                Segments = 40,
                Thickness = 0.28,
            },
            Molotov = {
                RadiusTrim = 4.5,
                HeightOffset = 0.3,
                Segments = 40,
                Thickness = 0.28,
            },
        }

        local function getMolotovColor()
            if options and options.GrenadeZoneColor then
                return options.GrenadeZoneColor.Value
            end

            return Color3.fromRGB(255, 60, 0)
        end

        local function getSmokeColor()
            if options and options.SmokeZoneColor then
                return options.SmokeZoneColor.Value
            end

            return Color3.fromRGB(180, 180, 180)
        end

        local activeZones = {}

        local zoneGroundRayParams = RaycastParams.new()
        zoneGroundRayParams.FilterType = Enum.RaycastFilterType.Exclude

        local function computeZoneInfo(zoneModel)
            local totalX, totalZ = 0, 0
            local lowestY = math.huge
            local count = 0
            local parts = {}

            for _, child in ipairs(zoneModel:GetChildren()) do
                if child:IsA("BasePart") then
                    count = count + 1
                    totalX = totalX + child.Position.X
                    totalZ = totalZ + child.Position.Z
                    local bottomY = child.Position.Y - child.Size.Y * 0.5

                    if bottomY < lowestY then
                        lowestY = bottomY
                    end

                    table.insert(parts, child)
                end
            end

            if count == 0 then
                return nil, nil, false
            end

            local centerX, centerZ = totalX / count, totalZ / count
            local maxRadius = 0

            for _, part in ipairs(parts) do
                local dx = part.Position.X - centerX
                local dz = part.Position.Z - centerZ
                local partRadius = math.max(part.Size.X, part.Size.Z) * 0.5
                local dist = math.sqrt(dx * dx + dz * dz) + partRadius

                if dist > maxRadius then
                    maxRadius = dist
                end
            end

            return Vector3.new(centerX, lowestY, centerZ), math.max(maxRadius, 1.2), true
        end

        local function groundHeightAt(x, y, z, ignoreParts)
            zoneGroundRayParams.FilterDescendantsInstances = ignoreParts or {}

            local raycast = workspace:Raycast(
                Vector3.new(x, y + 5, z), Vector3.new(0, -14, 0), zoneGroundRayParams
            )

            return raycast and raycast.Position.Y or y
        end

        local function makeRingSegment(color, thickness)
            local segment = Instance.new("Part")
            segment.Name = "WF_RingSeg"
            segment.Anchored = true
            segment.CanCollide = false
            segment.CanQuery = false
            segment.CastShadow = false
            segment.Material = Enum.Material.Neon
            segment.Color = color
            segment.Transparency = 1
            segment.Shape = Enum.PartType.Cylinder
            segment.Size = Vector3.new(thickness, thickness, thickness)
            segment.Parent = workspace

            return segment
        end

        local function createZoneEsp(zoneModel, settings, isMolotov)
            if activeZones[zoneModel] then
                return
            end

            local segments = settings.Segments or 40
            local thickness = settings.Thickness or 0.28
            local initialColor = isMolotov and getMolotovColor() or getSmokeColor()
            local cylinders = {}
            local allParts = {}

            for _ = 1, segments do
                local cylinder = makeRingSegment(initialColor, thickness)
                table.insert(cylinders, cylinder)
                table.insert(allParts, cylinder)
            end

            local zoneCache = {
                cylinders = cylinders,
                allParts = allParts,
                cfg = settings,
                isMolotov = isMolotov,
                lastRecalc = 0,
                lastRadius = 1,
                alive = true,
                fadingOut = false,
                fadeAlpha = 0,
            }

            activeZones[zoneModel] = zoneCache
            local spawnTime = tick()

            local function getCurrentAlpha()
                if zoneCache.fadingOut then
                    return zoneCache.fadeAlpha
                end

                return math.clamp((tick() - spawnTime) / 0.4, 0, 1)
            end

            local function startFadeOut()
                if zoneCache.fadingOut then
                    return
                end

                zoneCache.fadingOut = true
                zoneCache.fadeAlpha = getCurrentAlpha()

                local fadeStart = tick()
                local initialAlpha = zoneCache.fadeAlpha

                local fadeConn
                fadeConn = runService.Heartbeat:Connect(function()
                    local t = math.clamp((tick() - fadeStart) / 0.6, 0, 1)
                    zoneCache.fadeAlpha = initialAlpha * (1 - t)
                    local transparency = 1 - zoneCache.fadeAlpha

                    for _, cylinder in ipairs(cylinders) do
                        pcall(function() cylinder.Transparency = transparency end)
                    end

                    if t >= 1 then
                        fadeConn:Disconnect()
                        zoneCache.alive = false

                        for _, cylinder in ipairs(cylinders) do
                            pcall(function() cylinder:Destroy() end)
                        end

                        activeZones[zoneModel] = nil
                    end
                end)
            end

            zoneModel.AncestryChanged:Connect(function(_, parent)
                if parent == nil then
                    startFadeOut()
                end
            end)

            local updateConn
            updateConn = runService.Heartbeat:Connect(function()
                if not zoneCache.alive then
                    updateConn:Disconnect()
                    return
                end

                if not zoneModel or not zoneModel.Parent then
                    updateConn:Disconnect()
                    startFadeOut()
                    return
                end

                local now = tick()

                if now - zoneCache.lastRecalc < 0.05 then
                    return
                end

                zoneCache.lastRecalc = now
                local center, radius, valid = computeZoneInfo(zoneModel)

                if not valid then
                    return
                end

                local radiusTrim = settings.RadiusTrim or 0
                local smoothedRadius = zoneCache.lastRadius + (radius - zoneCache.lastRadius) * 0.25
                zoneCache.lastRadius = smoothedRadius
                local finalRadius = math.max(smoothedRadius - radiusTrim, 0.8)
                local currentTransparency = 1 - getCurrentAlpha()
                local currentColor = zoneCache.isMolotov and getMolotovColor() or getSmokeColor()

                for index, cylinder in ipairs(cylinders) do
                    local angleA = 2 * math.pi * ((index - 1) / segments)
                    local angleB = 2 * math.pi * (index / segments)
                    local angleMid = (angleA + angleB) / 2
                    local x1 = center.X + math.cos(angleA) * finalRadius
                    local z1 = center.Z + math.sin(angleA) * finalRadius
                    local x2 = center.X + math.cos(angleB) * finalRadius
                    local z2 = center.Z + math.sin(angleB) * finalRadius
                    local xMid = center.X + math.cos(angleMid) * finalRadius
                    local zMid = center.Z + math.sin(angleMid) * finalRadius
                    local y1 = groundHeightAt(x1, center.Y, z1, allParts) + (settings.HeightOffset or 0.3)
                    local y2 = groundHeightAt(x2, center.Y, z2, allParts) + (settings.HeightOffset or 0.3)
                    local yMid = (y1 + y2) * 0.5
                    local posA = Vector3.new(x1, y1, z1)
                    local posB = Vector3.new(x2, y2, z2)
                    local posMid = Vector3.new(xMid, yMid, zMid)
                    local delta = posB - posA
                    local length = delta.Magnitude

                    if length < 0.001 then
                        continue
                    end

                    cylinder.CFrame = CFrame.lookAt(posMid, posMid + delta)
                        * CFrame.Angles(0, math.rad(90), 0)

                    cylinder.Size = Vector3.new(length, thickness, thickness)
                    cylinder.Color = currentColor
                    cylinder.Transparency = currentTransparency
                end
            end)

            zoneCache.updateConn = updateConn
        end

