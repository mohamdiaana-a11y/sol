    task.spawn(function()
        local activeMarkers = {}

        showPenetration = function(worldPos)
            if not toggles.HitMarkerEnabled or not toggles.HitMarkerEnabled.Value then
                return
            end

            local duration = options.HitMarkerDuration and options.HitMarkerDuration.Value or 2
            local thickness = options.HitMarkerThickness and options.HitMarkerThickness.Value or 2
            local lines = {}

            for i = 1, 4 do
                local line = Drawing.new("Line")
                line.Thickness = thickness
                line.Transparency = 1
                line.Visible = false

                lines[i] = line
            end

            table.insert(activeMarkers, {
                lines = lines,
                worldPos = worldPos,
                spawnTick = tick(),
                expireTick = tick() + duration,
            })
        end

        runService.RenderStepped:Connect(function()
            pcall(function()
                local now = tick()
                local enabled = toggles.HitMarkerEnabled and toggles.HitMarkerEnabled.Value

                local color = options.HitMarkerColor and options.HitMarkerColor.Value
                    or Color3.fromRGB(255, 255, 255)

                if toggles.HitMarkerRainbow and toggles.HitMarkerRainbow.Value then
                    color = Color3.fromHSV(now % 5 / 5, 1, 1)
                end

                local size = options.HitMarkerSize and options.HitMarkerSize.Value or 25
                local spinSpeed = options.HitMarkerSpinSpeed and options.HitMarkerSpinSpeed.Value or 720
                local pulse = 1 + 0.35 * math.sin(now * math.pi)
                local outerDist = size * pulse
                local innerDist = 6 * pulse

                for i = #activeMarkers, 1, -1 do
                    local marker = activeMarkers[i]

                    if not enabled or now > marker.expireTick then
                        table.remove(activeMarkers, i)
                    else
                        local screenPos, onScreen = currentCamera:WorldToViewportPoint(marker.worldPos)

                        if onScreen then
                            local center = Vector2.new(screenPos.X, screenPos.Y)
                            local elapsed = now - marker.spawnTick
                            local baseAngle = math.rad(elapsed * spinSpeed % 360)
                            local angles = { 0, 90, 180, 270 }

                            for j = 1, 4 do
                                local line = marker.lines[j]
                                line.Color = color

                                line.Thickness = options.HitMarkerThickness and options.HitMarkerThickness.Value
                                    or 2

                                local angle = baseAngle + math.rad(angles[j])
                                local dx = math.cos(angle)
                                local dy = math.sin(angle)

                                line.From = center + Vector2.new(dx * innerDist, dy * innerDist)
                                line.To = center + Vector2.new(dx * (innerDist + outerDist), dy * (innerDist + outerDist))
                                line.Visible = true
                            end
                        else
                            for _, line in ipairs(marker.lines) do
                                line.Visible = false
                            end
                        end
                    end
                end
            end)
        end)
    end)

