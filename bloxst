            if skinState.KnifeChanger.Enabled then
                lookupName = skinState.KnifeChanger.Model
                shouldApply = true
            end
        elseif skinState.SkinChanger.Enabled then
            shouldApply = true
        end

        if not shouldApply then
            return
        end

        local skinName = skinState.SkinChanger.Skins[lookupName]

        if not skinName or skinName == "Default" then
            return
        end

        local modelFolder = skinsRoot:FindFirstChild(lookupName)

        if not modelFolder then
            return
        end

        local skinFolder = modelFolder:FindFirstChild(skinName)

        if not skinFolder then
            return
        end

        local cameraFolder = skinFolder:FindFirstChild("Camera")

        if not cameraFolder then
            return
        end

        local factoryNew = cameraFolder:FindFirstChild("Factory New")

        if not factoryNew then
            return
        end

        for _, appearance in pairs(factoryNew:GetChildren()) do
            if appearance:IsA("SurfaceAppearance") then
                local targetPart = weaponModel:FindFirstChild(appearance.Name, true)

                if targetPart
                    and (targetPart:IsA("BasePart") or targetPart:IsA("MeshPart")) then
                    for _, child in pairs(targetPart:GetChildren()) do
                        if child:IsA("SurfaceAppearance") then
                            child:Destroy()
                        end
                    end

                    appearance:Clone().Parent = targetPart
                end
            end
        end

        updateKnifeLabel()
    end

    local function applyGloveChanger()
        if not skinState.GloveChanger.Enabled then
            return
        end

        local camera = workspaceRef.CurrentCamera

        if not camera then
            return
        end

        local armsModel = nil

        for _, child in ipairs(camera:GetChildren()) do
            if child:IsA("Model")
                and (child.Name:match("Arms") or child:FindFirstChild("Right Arm")) then
                armsModel = child
                break
            end
        end

        if not armsModel then
            return
        end

        local leftArm = armsModel:FindFirstChild("Left Arm")
        local rightArm = armsModel:FindFirstChild("Right Arm")

        if not leftArm or not rightArm then
            return
        end

        local leftGlove = leftArm:FindFirstChild("Glove")
        local rightGlove = rightArm:FindFirstChild("Glove")

        if not leftGlove or not rightGlove then
            return
        end

        for _, child in pairs(leftGlove:GetChildren()) do
            if child:IsA("SurfaceAppearance") then
                child:Destroy()
            end
        end

        for _, child in pairs(rightGlove:GetChildren()) do
            if child:IsA("SurfaceAppearance") then
                child:Destroy()
            end
        end

        local modelName = skinState.GloveChanger.Model

        if not modelName then
            return
        end

        local skinName = skinState.GloveChanger.Gloves[modelName]

        if not skinName or skinName == "Default" then
            return
        end

        if not skinsRoot then
            return
        end

        local modelFolder = skinsRoot:FindFirstChild(modelName)

        if not modelFolder then
            return
        end

        local skinFolder = modelFolder:FindFirstChild(skinName)

        if not skinFolder then
            return
        end

        local cameraFolder = skinFolder:FindFirstChild("Camera")

        if not cameraFolder then
            return
        end

        local factoryNew = cameraFolder:FindFirstChild("Factory New")

        if not factoryNew then
            return
        end

        for _, appearance in pairs(factoryNew:GetChildren()) do
            if appearance:IsA("SurfaceAppearance") then
                appearance:Clone().Parent = leftGlove
                appearance:Clone().Parent = rightGlove
            end
        end
    end

    task.spawn(function()
        while true do
            pcall(function()
                if skinState.SkinChanger.Enabled or skinState.KnifeChanger.Enabled then
                    applySkinChanger()
                end

                if skinState.GloveChanger.Enabled then
                    applyGloveChanger()
                end
            end)

            task.wait(0.5)
        end
    end)
end

