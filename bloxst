    end)

    -- Satu tabbox per tab (seperti Evade), setiap groupbox jadi sub-tab di dalamnya.
    local function getTabbox(tabObj)
        if tabObj.Tabbox then
            return tabObj.Tabbox
        end

        local ok, box = pcall(function()
            return tabObj.Raw:AddCenterTabbox(tabObj.Name)
        end)

        if ok and box then
