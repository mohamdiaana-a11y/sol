        leftBar.BorderSizePixel = 0

        local rightBar = Instance.new("Frame", container)
        rightBar.AnchorPoint = Vector2.new(0, 0.5)
        rightBar.BorderSizePixel = 0

        local topBar = Instance.new("Frame", container)
        topBar.AnchorPoint = Vector2.new(0.5, 1)
        topBar.BorderSizePixel = 0

        local bottomBar = Instance.new("Frame", container)
        bottomBar.AnchorPoint = Vector2.new(0.5, 0)
        bottomBar.BorderSizePixel = 0

        runService.RenderStepped:Connect(function()
            pcall(function()
                local isScoped = false
                local playerGui = localPlayer:FindFirstChild("PlayerGui")

                if playerGui then
                    local ok, scope = pcall(function()
                        return playerGui.MainGui.Gameplay.Middle.SniperScope
                    end)

                    if ok and scope and scope.Visible then
                        isScoped = true
                    end
                end

                local shouldShow = toggles.CustomScopeCrosshair and toggles.CustomScopeCrosshair.Value
                    and isScoped

                container.Visible = shouldShow

                if shouldShow then
                    local color = options.ScopeCrosshairColor and options.ScopeCrosshairColor.Value
                        or Color3.fromRGB(255, 255, 255)

                    leftBar.BackgroundColor3 = color
                    rightBar.BackgroundColor3 = color
                    topBar.BackgroundColor3 = color
                    bottomBar.BackgroundColor3 = color

                    local thickness = options.ScopeCrosshairThickness
                            and options.ScopeCrosshairThickness.Value
                        or 2

                    local lengthLR = options.ScopeCrosshairLengthLR
                            and options.ScopeCrosshairLengthLR.Value
                        or 150

                    local lengthTB = options.ScopeCrosshairLengthTB
                            and options.ScopeCrosshairLengthTB.Value
                        or 100

                    leftBar.Size = UDim2.new(0, lengthLR, 0, thickness)
                    leftBar.Position = UDim2.new(0, 0, 0, 0)

