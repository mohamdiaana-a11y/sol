do
    local trackedCharacters = {}

    local function addEspForCharacter(character)
        if not character or trackedCharacters[character] then
            return
        end

        if character == localPlayer.Character then
            return
        end

        esplib.add_box(character)
        esplib.add_name(character)
        esplib.add_healthbar(character)
        esplib.add_healthtext(character)
        esplib.add_distance(character)
        esplib.add_tracer(character)
        esplib.add_skeleton(character, { thickness = 2 })
        esplib.add_weapon(character)
        esplib.add_circulartarget(character)

        trackedCharacters[character] = true
    end

    local function removeEspForCharacter(character)
        if character then
            if espInstances[character] then
                destroyEspCache(character, espInstances[character])
                espInstances[character] = nil
            end

            trackedCharacters[character] = nil
        end
    end

    local espCharactersFolder = workspaceRef:WaitForChild("Characters", 5)

    local function scanCharacters()
        if not espCharactersFolder then
            return
        end

        local function scanRecursive(root)
            for _, child in ipairs(root:GetChildren()) do
                if child:IsA("Model") then
                    if child:GetAttribute("Health") ~= nil or child:FindFirstChild("Head") then
                        addEspForCharacter(child)
                    end

                    scanRecursive(child)
                end
            end
        end

        scanRecursive(espCharactersFolder)
    end

    scanCharacters()

    if espCharactersFolder then
        espCharactersFolder.DescendantAdded:Connect(function(descendant)
            if descendant:IsA("Model") then
                task.wait(0.1)

                if descendant:GetAttribute("Health") ~= nil or descendant:FindFirstChild("Head") then
                    addEspForCharacter(descendant)
                end
            end
        end)

        espCharactersFolder.DescendantRemoving:Connect(function(descendant)
            if descendant:IsA("Model") then
                removeEspForCharacter(descendant)
            end
        end)
    end

    local function rescanAll()
        for character in next, trackedCharacters do
            removeEspForCharacter(character)
        end

        scanCharacters()
    end

    local function refreshAll()
        refreshEspSettings()
        rescanAll()
    end

    toggles.ESPEnabled:OnChanged(refreshAll)
    toggles.ESPTeamCheck:OnChanged(refreshAll)

    options.ESPBoxType:OnChanged(refreshEspSettings)
end

