    }

    local function shouldSkipInstance(instance)
        local character = localPlayer.Character

        if character and (instance == character or instance:IsDescendantOf(character)) then
            return true
        end

        if instance:IsDescendantOf(workspaceRef.CurrentCamera) then
            return true
        end

        if instance.Name == "CubeChecker_Physical" or instance.Name:find("Solana_") then
            return true
        end

        return false
