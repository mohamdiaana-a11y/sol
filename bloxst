local function traceBulletPath(origin, direction, extraThickness, ignoreList, hitTarget)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.CollisionGroup = "Bullet"

    local filters = ignoreList or { localPlayer.Character, currentCamera }
    raycastParams.FilterDescendantsInstances = filters
    local position = origin
    local materialTotals = {}
    local variantTotals = {}

    local result = {
        TotalThickness = 0,
        MaterialStats = {},
        Success = false,
        FailReason = "Max Steps",
        EndPos = Vector3.zero,
    }

    local includeParams = RaycastParams.new()
    includeParams.FilterType = Enum.RaycastFilterType.Include
    includeParams.CollisionGroup = "Bullet"

    for _ = 1, 100 do
        if not position or not direction then
            break
        end

        local raycast = workspaceRef:Raycast(position, direction * 1000, raycastParams)

        if not raycast then
            if not hitTarget then
                result.Success = true
                result.EndPos = position + direction * 1000
            else
                result.FailReason = "Void (Missed)"
            end

            break
        end

        if not raycast.Instance or not raycast.Instance.Parent then
            result.FailReason = "Destroyed Instance"
            break
        end

        if hitTarget and raycast.Instance:IsDescendantOf(hitTarget) then
            result.Success = true
            result.EndPos = raycast.Position
            result.FailReason = "Hit"

            return result
        end

        table.insert(filters, raycast.Instance)
        raycastParams.FilterDescendantsInstances = filters
        local hitPosition = raycast.Position
        local backOrigin = hitPosition + direction * 1000
        includeParams.FilterDescendantsInstances = { raycast.Instance }
        local backRaycast = workspaceRef:Raycast(backOrigin, hitPosition - backOrigin, includeParams)
        local thickness = 0.5

        if not backRaycast then
            thickness = 5
            result.FailReason = "Infinite/Block"
        else
            thickness = (hitPosition - backRaycast.Position).Magnitude
            local variant = backRaycast.Instance.MaterialVariant

            if variant ~= "" and variantPenetration[variant] then
                local limit = variantPenetration[variant]
                variantTotals[variant] = (variantTotals[variant] or 0) + thickness

                if variantTotals[variant] > limit + extraThickness then
                    result.FailReason = string.format(
                        "Var: %s (%.1f > %.1f)", variant, variantTotals[variant], limit + extraThickness
                    )

                    result.MaterialStats = {
                        Type = "Variant",
                        Name = variant,
                        Thickness = variantTotals[variant],
                        Limit = limit + extraThickness,
                    }

                    return result
                end
            else
                local material = backRaycast.Material
                local limit = materialPenetration[material] or 0.25
                materialTotals[material] = (materialTotals[material] or 0) + thickness

                if materialTotals[material] > limit + extraThickness then
                    result.FailReason = string.format(
                        "%s (%.1f / %.1f)", material.Name, materialTotals[material], limit + extraThickness
                    )

                    result.MaterialStats = {
                        Type = "Material",
                        Name = material.Name,
                        Thickness = materialTotals[material],
                        Limit = limit + extraThickness,
                    }

                    return result
                end
            end

            position = backRaycast.Position
        end

        result.TotalThickness = result.TotalThickness + thickness
    end

    return result
end

local function getMovementDirection()
    local direction = Vector3.zero
    local lookVector = currentCamera.CFrame.LookVector
    local rightVector = currentCamera.CFrame.RightVector

    if userInputService:IsKeyDown(Enum.KeyCode.W) then
        direction = direction + lookVector
    end

    if userInputService:IsKeyDown(Enum.KeyCode.S) then
        direction = direction - lookVector
    end

    if userInputService:IsKeyDown(Enum.KeyCode.A) then
        direction = direction - rightVector
    end

    if userInputService:IsKeyDown(Enum.KeyCode.D) then
        direction = direction + rightVector
    end

    return Vector3.new(direction.X, 0, direction.Z).Unit
end

