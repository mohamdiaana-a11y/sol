                    color = Color3.fromHSV(tick() % 5 / 5, 1, 1)
                end

                local origin = camera.CFrame.Position
                local direction = camera.CFrame.LookVector * maxDist

                cubeRayParams.FilterDescendantsInstances = {
                    localPlayer.Character, cubeChecker,
                }

                local raycast = workspaceRef:Raycast(origin, direction, cubeRayParams)

                if raycast then
                    cubeChecker.Parent = workspaceRef

                    cubeChecker.CFrame = CFrame.lookAt(
                        raycast.Position + raycast.Normal * 0.02, raycast.Position + raycast.Normal
                    )

