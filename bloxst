    legitAimDeps:SetupDependencies({ { toggles.LegitAimbotEnabled, true } })
end

do
    local legitTriggerGroupbox = tabs.Combat:AddRightGroupbox("Legit Triggerbot", "target")

    legitTriggerGroupbox:AddToggle("LegitTriggerbotEnabled", {
        Text = "Enable Legit Triggerbot",
        Default = false,
    }):AddKeyPicker("LegitTriggerbotKey", {
        Text = "Triggerbot Key",
        Default = "None",
        Mode = "Toggle",
    })

    local legitTriggerDeps = legitTriggerGroupbox:AddDependencyBox()

    legitTriggerDeps:AddSlider("LegitTriggerDelay", {
        Text = "Trigger Delay",
        Default = 0.08,
        Min = 0.01,
        Max = 0.5,
        Rounding = 3,
        Suffix = "s",
    })

    legitTriggerDeps:AddToggle("LegitTriggerVisibleCheck", {
        Text = "Visible Check",
        Default = true,
    })

    legitTriggerDeps:AddToggle("LegitTriggerTeamCheck", { Text = "Team Check", Default = true })
    legitTriggerDeps:AddToggle("LegitTriggerWallbang", { Text = "Wallbang", Default = false })

    legitTriggerDeps:AddToggle("LegitTriggerNotify", {
        Text = "Show Trigger Flash",
        Default = false,
    })

    legitTriggerDeps:SetupDependencies({ { toggles.LegitTriggerbotEnabled, true } })

    local aimFovCircle = Drawing.new("Circle")
    aimFovCircle.NumSides = 128
    aimFovCircle.Thickness = 1.5
    aimFovCircle.Filled = false
    aimFovCircle.Transparency = 1
    aimFovCircle.Visible = false

    local aimTargetCircle = Drawing.new("Circle")
    aimTargetCircle.NumSides = 48
    aimTargetCircle.Thickness = 2
    aimTargetCircle.Filled = false
    aimTargetCircle.Transparency = 0.8
    aimTargetCircle.Visible = false

    local function isLegitAimbotActive()
        if not (toggles.LegitAimbotEnabled and toggles.LegitAimbotEnabled.Value) then
            return false
        end

        local key = options.LegitAimbotKey

        if key and key.Value ~= "None" and key.Value ~= "Always" then
            return key:GetState()
        end

        return true
    end

    local function isLegitTriggerActive()
        if not (toggles.LegitTriggerbotEnabled and toggles.LegitTriggerbotEnabled.Value) then
            return false
        end

        local key = options.LegitTriggerbotKey

        if key and key.Value ~= "None"
            and key.Value ~= "Always" and key.Value ~= "Toggle" then
            return key:GetState()
        end

        return true
    end

    local function isTargetAttackable(character, checkTeam, checkVisible, hitPart)
        if not character or not hitPart then
            return false
        end

        if character == localPlayer.Character then
            return false
        end

        if character:GetAttribute("Dead") or character:GetAttribute("Invincible") then
            return false
        end

        local health = character:GetAttribute("Health")

        if health ~= nil and health <= 0 then
            return false
        end

        if checkTeam then
            local player = players:GetPlayerFromCharacter(character)

            if player and getPlayerTeamName(player) == getPlayerTeamName(localPlayer) then
                return false
            end
        end

        if checkVisible then
            if not isTargetVisible(hitPart) then
                return false
            end
        end

        return true
    end

    local function findLegitAimTarget()
        local camera = workspaceRef.CurrentCamera

        if not camera then
            return nil
        end

        local localCharacter = localPlayer.Character

        if not localCharacter then
            return nil
        end

        local characters = workspaceRef:FindFirstChild("Characters")

        if not characters then
            return nil
        end

        local hitPartName = options.LegitAimHitPart and options.LegitAimHitPart.Value or "Head"
        local fovRadius = options.LegitAimFovRadius and options.LegitAimFovRadius.Value or 120
        local checkVisible = toggles.LegitAimVisibleCheck and toggles.LegitAimVisibleCheck.Value
        local checkTeam = toggles.LegitAimTeamCheck and toggles.LegitAimTeamCheck.Value
        local wallbang = toggles.LegitAimWallbang and toggles.LegitAimWallbang.Value
        local viewportCenter = camera.ViewportSize / 2
        local bestTarget, bestScore = nil, fovRadius

        for _, descendant in ipairs(characters:GetDescendants()) do
            if descendant:IsA("Model") and descendant ~= localCharacter then
                local part = descendant:FindFirstChild(hitPartName)
                    or descendant:FindFirstChild("Head") or descendant:FindFirstChild("HumanoidRootPart")

                if part then
                    local passVisible = wallbang or true

                    if not wallbang and checkVisible then
                        passVisible = isTargetVisible(part)
                    end

                    if passVisible and isTargetAttackable(descendant, checkTeam, false, part) then
                        local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)

                        if onScreen then
                            local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude

                            if screenDist < bestScore then
                                bestScore = screenDist

                                bestTarget = {
                                    part = part,
                                    char = descendant,
                                    screen = Vector2.new(screenPos.X, screenPos.Y),
                                    world = part.Position,
                                }
                            end
                        end
                    end
                end
            end
        end

        return bestTarget
    end

    runService.RenderStepped:Connect(function(delta)
        local camera = workspaceRef.CurrentCamera

        if not camera then
            return
        end

        local viewportCenter = camera.ViewportSize / 2
        local aimActive = isLegitAimbotActive()
        local showFov = toggles.LegitAimFovCircle and toggles.LegitAimFovCircle.Value and aimActive
        aimFovCircle.Visible = showFov

        if showFov then
            aimFovCircle.Position = viewportCenter
            aimFovCircle.Radius = options.LegitAimFovRadius and options.LegitAimFovRadius.Value or 120

            aimFovCircle.Color = options.LegitAimFovColor and options.LegitAimFovColor.Value
                or Color3.fromRGB(0, 255, 150)
        end

        local target = nil

        if aimActive then
            target = findLegitAimTarget()

            if target then
                local smooth = 1 / math.clamp(
                    options.LegitAimSmoothness and options.LegitAimSmoothness.Value or 5, 1, 20
                )

                local newCFrame = CFrame.new(camera.CFrame.Position, target.world)
                camera.CFrame = camera.CFrame:Lerp(newCFrame, smooth)

                if toggles.LegitAimDrawTarget and toggles.LegitAimDrawTarget.Value then
                    aimTargetCircle.Visible = true
                    aimTargetCircle.Position = target.screen
                    aimTargetCircle.Radius = 12

                    aimTargetCircle.Color = options.LegitAimFovColor and options.LegitAimFovColor.Value
                        or Color3.fromRGB(0, 255, 150)
                else
                    aimTargetCircle.Visible = false
                end
            else
                aimTargetCircle.Visible = false
            end
        else
            aimTargetCircle.Visible = false
        end
    end)

    task.spawn(function()
        local triggerRayParams = RaycastParams.new()
        triggerRayParams.FilterType = Enum.RaycastFilterType.Exclude
        triggerRayParams.IgnoreWater = true

        local lastTriggerTime = 0

        while true do
            task.wait(0.01)

            pcall(function()
                if not isLegitTriggerActive() then
                    return
                end

                local camera = workspaceRef.CurrentCamera

                if not camera then
                    return
                end

                local localCharacter = localPlayer.Character

                if not localCharacter then
                    return
                end

                local now = tick()
                local delay = options.LegitTriggerDelay and options.LegitTriggerDelay.Value or 0.08

                if now - lastTriggerTime < delay then
                    return
                end

                triggerRayParams.FilterDescendantsInstances = { localCharacter }

                local raycast = workspaceRef:Raycast(
                    camera.CFrame.Position, camera.CFrame.LookVector * 500,
                    triggerRayParams
                )

                if not raycast or not raycast.Instance then
                    return
                end

                local model = raycast.Instance:FindFirstAncestorOfClass("Model")

                if not model then
                    return
                end

                local checkVisible = toggles.LegitTriggerVisibleCheck
                    and toggles.LegitTriggerVisibleCheck.Value

                local checkTeam = toggles.LegitTriggerTeamCheck and toggles.LegitTriggerTeamCheck.Value

                if not (toggles.LegitTriggerWallbang and toggles.LegitTriggerWallbang.Value)
                    and checkVisible and not isTargetVisible(raycast.Instance) then
                    return
                end

                if not isTargetAttackable(model, checkTeam, false, raycast.Instance) then
                    return
                end

                if currentEquippedData and currentEquippedData.IsEquipped and currentEquippedData.Rounds > 0 then
                    pcall(function() currentEquippedData:shoot() end)
                    lastTriggerTime = now

                    if toggles.LegitTriggerNotify and toggles.LegitTriggerNotify.Value then
                        aimTargetCircle.Visible = true
                        aimTargetCircle.Position = workspaceRef.CurrentCamera.ViewportSize / 2
                        aimTargetCircle.Radius = 20
                        aimTargetCircle.Color = Color3.fromRGB(255, 80, 80)

                        task.delay(0.12, function() aimTargetCircle.Visible = false end)
                    end
                end
            end)
        end
    end)
end

