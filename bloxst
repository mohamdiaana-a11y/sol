    local grenadeTracerCache = {}

    local function startGrenadeTracer(handle)
        if not handle or not handle:IsA("BasePart") then
            return
        end

        if grenadeTracerCache[handle] then
            return
        end

        local trail = {}
        local lines = {}

        for i = 1, 30 do
            local line = Drawing.new("Line")
            line.Visible = false
            line.Thickness = 2
            line.Transparency = 1

            lines[i] = line
        end

        grenadeTracerCache[handle] = lines

        local conn
        conn = runService.RenderStepped:Connect(function()
            local enabled = toggles and toggles.GrenadeTracers and toggles.GrenadeTracers.Value

            local color = options and options.GrenadeTracerColor
                    and options.GrenadeTracerColor.Value
                or Color3.fromRGB(255, 100, 0)

            if not handle or not handle.Parent then
                conn:Disconnect()
                grenadeTracerCache[handle] = nil

                for _, line in ipairs(lines) do
                    pcall(function() line:Remove() end)
                end

                return
            end

            if not enabled then
                for _, line in ipairs(lines) do
                    line.Visible = false
                end

                return
            end

            table.insert(trail, 1, handle.Position)

            if #trail > 31 then
                table.remove(trail)
            end

            local camera = workspace.CurrentCamera

            for i = 1, 30 do
                local line = lines[i]
                local posA = trail[i]
                local posB = trail[i + 1]

                if not posA or not posB then
                    line.Visible = false
                    continue
                end

                local screenA, onA = camera:WorldToViewportPoint(posA)
                local screenB, onB = camera:WorldToViewportPoint(posB)

                if (onA or onB) and screenA.Z > 0 and screenB.Z > 0 then
                    local fade = 1 - i / 30

                    line.From = Vector2.new(screenA.X, screenA.Y)
                    line.To = Vector2.new(screenB.X, screenB.Y)
                    line.Color = color
                    line.Thickness = math.max(2 * fade, 0.5)
                    line.Transparency = 1 - fade
                    line.Visible = true
                else
                    line.Visible = false
                end
            end
        end)
    end

    local trackedProjectiles = {}

    local grenadeKeywords = {
        "grenade", "flash", "molotov", "bang", "frag", "he_", "_he", "throwable", "projectile",
        "nade", "incendiary", "decoy", "c4",
    }

    local excludedKeywords = {
        "gun", "rifle", "pistol", "bullet", "casing", "debris", "light", "muzzle", "launch",
        "effect", "arm", "leg", "torso", "head", "humanoid", "mesh", "handle", "constraint", "weld",
        "motor", "zone", "voxel",
    }

    local function isGrenadeObject(instance)
        if not instance:IsA("BasePart") and not instance:IsA("Model") then
            return false
        end

        local lowerName = instance.Name:lower()

        for _, keyword in ipairs(excludedKeywords) do
            if lowerName:find(keyword) then
                return false
            end
        end

        if #lowerName > 20 and lowerName:find("%-") then
            return true
        end

        for _, keyword in ipairs(grenadeKeywords) do
            if lowerName:find(keyword) then
                return true
            end
        end

        return false
    end

    local function tryTrackGrenade(instance)
        if trackedProjectiles[instance] then
            return
        end

        local handle = instance

        if instance:IsA("Model") then
            handle = instance:FindFirstChild("Handle") or instance:FindFirstChildWhichIsA("BasePart")
        end

        if not handle or not handle:IsA("BasePart") then
            return
        end

        if handle.Size.Magnitude > 8 then
            return
        end

        if players:GetPlayerFromCharacter(instance) then
            return
        end

        if players:GetPlayerFromCharacter(instance.Parent) then
            return
        end

        trackedProjectiles[instance] = true

        local conn
        conn = instance.AncestryChanged:Connect(function(_, parent)
            if parent == nil then
                trackedProjectiles[instance] = nil
                conn:Disconnect()
            end
        end)

        startGrenadeTracer(handle)
    end

