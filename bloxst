    local function stripTags(text)
        return (tostring(text or ""):gsub("<[^>]+>", ""))
    end

    local function iconOf(name)
        name = tostring(name or "layers")

        if name:find(":") then
            return name
        end

        return "lucide:" .. name
    end

    local function makeFlag(prefix, scope, title)
        local base = prefix .. ":" .. tostring(scope) .. "/" .. title
        flagCounts[base] = (flagCounts[base] or 0) + 1

        if flagCounts[base] > 1 then
            base = base .. "#" .. flagCounts[base]
        end

        return base
    end

    local function callHost(host, method, cfg)
        local fn = host and host[method]

        if type(fn) ~= "function" then
            return nil
        end

        local ok, result = pcall(fn, host, cfg)

        if not ok then
            warn("[Solana Hub] " .. method .. " gagal: " .. tostring(result))
            return nil
        end

        return result
    end

    local function unitOf(suffix)
        if suffix == nil or suffix == "" then
            return ""
        end

        if suffix == "%" then
            return "%"
        end

        return " " .. tostring(suffix)
    end

    local function applyUiValue(handle, value)
        if not handle then
            return
        end

        for _, method in ipairs({ "SetValue", "Set", "Select" }) do
            local fn = handle[method]

            if type(fn) == "function" and pcall(fn, handle, value) then
                return
            end
        end
    end

    -- Dipanggil saat user mengubah nilai dari UI.
    local function userSet(entry, value)
        if entry.Value == value then
            return
        end

        entry.Value = value

        if entry.Callback then
            pcall(entry.Callback, value)
        end

        for _, fn in ipairs(entry.Changed) do
            pcall(fn, value)
        end
    end

    -- Menambahkan method yang dipakai script: OnChanged, SetValue, AddKeyPicker, AddColorPicker.
    local function registerMethods(entry, registry, id)
        registry[id] = entry

        entry.OnChanged = function(_, fn)
            table.insert(entry.Changed, fn)
        end

        entry.SetValue = function(_, value)
            if entry.Kind == "toggle" then
                value = value == true
            end

            if entry.Value ~= value then
                entry.Value = value

                if entry.Callback then
                    pcall(entry.Callback, value)
                end

                for _, fn in ipairs(entry.Changed) do
                    pcall(fn, value)
                end
            end

            applyUiValue(entry.Handle, value)
        end

        entry.AddKeyPicker = function(_, keyId, keyCfg)
            return addKeyPicker(keyId, keyCfg, entry)
        end

        entry.AddColorPicker = function(_, colorId, colorCfg)
            return addColorPicker(colorId, colorCfg)
        end

        return entry
    end

    addKeyPicker = function(keyId, keyCfg, owner)
        local entry = {
            Kind = "key",
            Value = keyCfg.Default or "None",
            Mode = keyCfg.Mode or "Toggle",
            Callback = keyCfg.Callback,
            ChangedCallback = keyCfg.ChangedCallback,
            Changed = {},
            Latched = false,
            Owner = owner,
        }

        entry.GetState = function()
            if entry.Mode == "Always" then
                return true
            end

            if entry.Mode == "Toggle" then
                return entry.Latched == true
            end

            return keyDownState[entry.Value] == true
        end

        entry.SetValue = function(_, value)
            entry.Value = value

            if entry.ChangedCallback then
                pcall(entry.ChangedCallback, value)
            end
        end

        entry.OnChanged = function(_, fn)
            table.insert(entry.Changed, fn)
        end

        table.insert(keyPickers, entry)
        options[keyId] = entry

        return entry
    end

    addColorPicker = function(colorId, colorCfg)
        local entry = {
            Kind = "color",
            Value = colorCfg.Default or Color3.new(1, 1, 1),
            Callback = colorCfg.Callback,
            Changed = {},
        }

        entry.OnChanged = function(_, fn)
            table.insert(entry.Changed, fn)
        end

        entry.SetValue = function(_, value)
            entry.Value = value

            for _, fn in ipairs(entry.Changed) do
                pcall(fn, value)
            end
        end

        options[colorId] = entry

        return entry
    end

    userInputService.InputBegan:Connect(function(input, gameProcessed)
        local keyName = input.KeyCode.Name
        keyDownState[keyName] = true

        if gameProcessed then
            return
        end

        for _, entry in ipairs(keyPickers) do
            if entry.Value == keyName then
                if entry.Mode == "Toggle" then
                    entry.Latched = not entry.Latched
                end

                if entry.Callback then
                    pcall(entry.Callback, true)
                end
            end
        end
    end)

