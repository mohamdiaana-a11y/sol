    local function applyWorldColor(instance)
        if shouldSkipInstance(instance) then
            return
        end

        if instance:IsA("BasePart") then
            if not instance:GetAttribute("OriginalColor") then
                instance:SetAttribute("OriginalColor", instance.Color)
            end

            instance.Color = colorState.WorldColor
        elseif instance:IsA("Texture") or instance:IsA("Decal") then
            if not instance:GetAttribute("OriginalColor3") then
                instance:SetAttribute("OriginalColor3", instance.Color3)
            end

            instance.Color3 = colorState.WorldColor
        end
    end

    local function restoreWorldColor(instance)
        if instance:IsA("BasePart") then
            if instance:GetAttribute("OriginalColor") then
                instance.Color = instance:GetAttribute("OriginalColor")
            end
        elseif instance:IsA("Texture") or instance:IsA("Decal") then
            if instance:GetAttribute("OriginalColor3") then
                instance.Color3 = instance:GetAttribute("OriginalColor3")
            end
        end
    end

