local visibilityRayParams = RaycastParams.new()
visibilityRayParams.FilterType = Enum.RaycastFilterType.Exclude
visibilityRayParams.IgnoreWater = true

local tickCounter = 0

local function isTargetVisible(targetPart)
    local filter = { localPlayer.Character }
    local localTeam = getPlayerTeamName(localPlayer)

    for _, player in ipairs(players:GetPlayers()) do
        if player ~= localPlayer and getPlayerTeamName(player) == localTeam and player.Character then
            table.insert(filter, player.Character)
        end
    end

    visibilityRayParams.FilterDescendantsInstances = filter
    local origin = workspaceRef.CurrentCamera.CFrame.Position
    local raycast = workspaceRef:Raycast(origin, targetPart.Position - origin, visibilityRayParams)

    if raycast then
        local hitPlayer = players:GetPlayerFromCharacter(
            (raycast.Instance:FindFirstAncestorOfClass("Model"))
        )

        if hitPlayer and hitPlayer.Character == targetPart.Parent then
            return true
        end

        return false
    end

    return true
end

local function isYantoModeActive()
    local active = toggles.WurfefMainToggle and toggles.WurfefMainToggle.Value

    if options.WurfefKeybind then
        local state = options.WurfefKeybind:GetState()

        if options.WurfefKeybind.Value ~= "None" and options.WurfefKeybind.Value ~= "Always"
            and options.WurfefKeybind.Value ~= "Toggle" then
            active = state
        end
    end

    return active
end

local function isTeamFriendly(targetCharacter)
    if not targetCharacter then
        return false
    end

    local localCharacter = localPlayer.Character

    if not localCharacter then
        return false
    end

    local localHasArmor = hasArmorVest(localCharacter)
    local targetHasArmor = hasArmorVest(targetCharacter)

    if localHasArmor then
        return not targetHasArmor
    end

    return targetHasArmor
end

do
    local function updateCombatTargets()
        local camera = workspaceRef.CurrentCamera
        local localCharacter = localPlayer.Character

        if not localCharacter then
            return
        end

        local localTeam = getPlayerTeamName(localPlayer)
        local viewportCenter = camera.ViewportSize / 2
        local bestSilentScore, bestSilentTarget = math.huge, nil
        local bestRageScore, bestRageTarget = math.huge, nil
        local yantoTarget = nil
        local yantoActive = isYantoModeActive()
        local characters = workspaceRef:FindFirstChild("Characters")

        if not characters then
            return
        end

        local candidates = {}

        for _, descendant in ipairs(characters:GetDescendants()) do
            if descendant:IsA("Model") then
                if (descendant:FindFirstChild("Head") or descendant:FindFirstChild("HumanoidRootPart"))
                    and descendant ~= localCharacter then
                    local dead = descendant:GetAttribute("Dead") or descendant:GetAttribute("Invincible")
                    local health = descendant:GetAttribute("Health")

                    if not dead and (health == nil or health > 0) then
                        table.insert(candidates, descendant)
                    end
                end
            end
        end

        if yantoActive then
            local hitPartName = options.CubeHitPart.Value or "Head"

            if cubeTarget and cubeTarget.Parent then
                local parent = cubeTarget.Parent
                local dead = parent:GetAttribute("Dead") or parent:GetAttribute("Invincible")
                local health = parent:GetAttribute("Health")

                if dead or health and health <= 0 then
                    cubeTarget = nil
                elseif toggles.CubeVisibleCheck and toggles.CubeVisibleCheck.Value then
                    if not isTargetVisible(cubeTarget) then
                        cubeTarget = nil
                    end
                end
            else
                cubeTarget = nil
            end

            local chosenTarget = cubeTarget
            local bestDistance = math.huge

            if cubeTarget then
                local part = cubeTarget.Parent:FindFirstChild(hitPartName) or cubeTarget

                if part then
                    bestDistance = (camera.CFrame.Position - part.Position).Magnitude
                end
            end

            for _, candidate in ipairs(candidates) do
                if not isTeamFriendly(candidate) then
                    continue
                end

                local part = candidate:FindFirstChild(hitPartName)
                    or candidate:FindFirstChild("Head") or candidate:FindFirstChild("HumanoidRootPart")

                if not part then
                    continue
                end

                local visible = true

                if toggles.CubeVisibleCheck and toggles.CubeVisibleCheck.Value then
                    if not isTargetVisible(part) then
                        visible = false
                    end
                end

                if visible then
                    local distance = (camera.CFrame.Position - part.Position).Magnitude

                    if distance < bestDistance then
                        bestDistance = distance
                        chosenTarget = part
                    end
                end
            end

            cubeTarget = chosenTarget
            yantoTarget = chosenTarget
        else
            cubeTarget = nil
        end

        for _, candidate in ipairs(candidates) do
            local isEnemy = isTeamFriendly(candidate)

            if toggles.Ragebot and toggles.Ragebot.Value
                and (isEnemy or not (toggles.RagebotTeamCheck and toggles.RagebotTeamCheck.Value)) then
                local part = candidate:FindFirstChild(options.RageHitPart.Value)
                    or candidate:FindFirstChild("Head") or candidate:FindFirstChild("HumanoidRootPart")

                if part then
                    local _, onScreen = camera:WorldToViewportPoint(part.Position)
                    local valid = true

                    if toggles.RagebotVisibleCheck and toggles.RagebotVisibleCheck.Value and not onScreen then
                        valid = false
                    end

                    if valid and toggles.RagebotWallCheck and toggles.RagebotWallCheck.Value then
                        if not isTargetVisible(part) then
                            valid = false
                        end
                    end

                    if valid then
                        local distance = (camera.CFrame.Position - part.Position).Magnitude
                        local player = players:GetPlayerFromCharacter(candidate)

                        if lockedTargetRage and player and player.Name == lockedTargetRage then
                            bestRageTarget = part
                            bestRageScore = 0
                        elseif distance < bestRageScore and bestRageScore > 0 then
                            bestRageScore = distance
                            bestRageTarget = part
                        end
                    end
                end
            end

            if toggles.SilentAim and toggles.SilentAim.Value
                and (isEnemy or not (toggles.SilentTeamCheck and toggles.SilentTeamCheck.Value)) then
                local part = candidate:FindFirstChild(options.SilentHitPart
                          and options.SilentHitPart.Value
                        or "Head")
                    or candidate:FindFirstChild("Head")
                    or candidate:FindFirstChild("HumanoidRootPart")

                if part then
                    local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)

                    if onScreen then
                        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude

                        if screenDist
                            <= (toggles.SilentUseFovCircle
                                  and toggles.SilentUseFovCircle.Value
                                  and (options.SilentFovCircleRadius and options.SilentFovCircleRadius.Value
                                    or 50)
                                or 999999) then
                            if (toggles.SilentWallbang and toggles.SilentWallbang.Value or isTargetVisible(part))
                                and screenDist < bestSilentScore then
                                bestSilentScore = screenDist
                                bestSilentTarget = part
                            end
                        end
                    end
                end
            end
        end

        lockedTargetSilent = bestSilentTarget
        lockedTargetRage = bestRageTarget
        lockedTargetCube = yantoTarget
    end

    local showTargetLines = {}

    for i = 1, 4 do
        local line = Drawing.new("Line")
        line.Thickness = 2
        line.Transparency = 1
        line.Visible = false

        showTargetLines[i] = line
    end

    local showTargetLine = Drawing.new("Line")
    showTargetLine.Thickness = 1.5
    showTargetLine.Transparency = 1
    showTargetLine.Visible = false

    runService.RenderStepped:Connect(function()
        pcall(function()
            local camera = workspaceRef.CurrentCamera
            local showTargetEnabled = isYantoModeActive() and toggles.ShowTargetPlayer and toggles.ShowTargetPlayer.Value
            local targetMode = options.ShowTargetMode and options.ShowTargetMode.Value or "Crosshair"
            local targetPart = nil
            local bestDistance = math.huge
            local localTeam = getPlayerTeamName(localPlayer)
            local hitPartName = options.CubeHitPart and options.CubeHitPart.Value or "Head"

            if showTargetEnabled then
                for _, player in ipairs(players:GetPlayers()) do
                    if player ~= localPlayer then
                        local character = player.Character

                        if character then
                            local humanoid = character:FindFirstChildOfClass("Humanoid")

                            if not (character:GetAttribute("Dead") or character:GetAttribute("Invincible")
                                or humanoid and humanoid.Health <= 0) then
                                if localTeam ~= getPlayerTeamName(player) then
                                    local part = character:FindFirstChild(hitPartName)
                                        or character:FindFirstChild("Head")
                                        or character:FindFirstChild("HumanoidRootPart")

                                    if part then
                                        local distance = (camera.CFrame.Position - part.Position).Magnitude

                                        if distance < bestDistance then
                                            bestDistance = distance
                                            targetPart = part
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end

            local isLineVisible = false
            local isCrosshairVisible = false

            if showTargetEnabled and targetPart and targetPart.Parent then
                local screenPos = camera:WorldToViewportPoint(targetPart.Position)
                local screenPoint = Vector2.new(screenPos.X, screenPos.Y)
                local now = tick()

                if targetMode == "Crosshair" then
                    local color = options.ShowTargetCrosshairColor
                            and options.ShowTargetCrosshairColor.Value
                        or Color3.fromRGB(0, 255, 255)

                    local pulse = 1 + 0.3 * math.sin(now * math.pi * 2)
                    local outerSize = 16 * pulse
                    local innerSize = 5 * pulse
                    local baseAngle = math.rad(now * 180 % 360)
                    local offsets = { 0, math.pi / 2, math.pi, 3 * math.pi / 2 }

                    for i = 1, 4 do
                        local line = showTargetLines[i]
                        line.Color = color
                        line.Thickness = 2

                        local angle = baseAngle + offsets[i]
                        local dx = math.cos(angle)
                        local dy = math.sin(angle)

                        line.From = screenPoint + Vector2.new(dx * innerSize, dy * innerSize)
                        line.To = screenPoint + Vector2.new(dx * (innerSize + outerSize), dy * (innerSize + outerSize))
                        line.Visible = true
                    end

                    isCrosshairVisible = true
                elseif targetMode == "Line" then
                    local color = options.ShowTargetLineColor and options.ShowTargetLineColor.Value
                        or Color3.fromRGB(0, 255, 255)

                    showTargetLine.From = camera.ViewportSize / 2
                    showTargetLine.To = screenPoint
                    showTargetLine.Color = color
                    showTargetLine.Visible = true

                    isLineVisible = true
                end
            end

            if not isCrosshairVisible then
                for i = 1, 4 do
                    showTargetLines[i].Visible = false
                end
            end

            if not isLineVisible then
                showTargetLine.Visible = false
            end

            if not showTargetEnabled then
                for i = 1, 4 do
                    showTargetLines[i].Visible = false
                end

                showTargetLine.Visible = false
            end
        end)
    end)

    runService.RenderStepped:Connect(function()
        tickCounter = tickCounter + 1
        local camera = workspaceRef.CurrentCamera
        local viewportCenter = camera.ViewportSize / 2

        pcall(function()
            silentFovCircle.Position = viewportCenter

            silentFovCircle.Radius = options.SilentFovCircleRadius and options.SilentFovCircleRadius.Value
