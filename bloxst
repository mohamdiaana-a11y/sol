local function hideAllEsp(cache)
    if cache.box then
        hideBox(cache.box)
    end

    if cache.healthbar then
        cache.healthbar.background.Visible = false

        for _, segment in ipairs(cache.healthbar.segments) do
            segment.Visible = false
        end
    end

    if cache.healthtext then
        cache.healthtext.Visible = false
    end

    if cache.name then
        cache.name.Visible = false
    end

    if cache.distance then
        cache.distance.Visible = false
    end

    if cache.tracer then
        cache.tracer.outline.Visible = false
        cache.tracer.fill.Visible = false
    end

    if cache.skeleton then
        for _, line in ipairs(cache.skeleton.lines) do
            line.Visible = false
        end
    end

    if cache.weapon then
        cache.weapon.Visible = false
    end

    if cache.circulartarget then
        for _, line in ipairs(cache.circulartarget.lines) do
            line.Visible = false
        end

        for _, line in ipairs(cache.circulartarget.trailLines) do
            line.Visible = false
        end

        for _, line in ipairs(cache.circulartarget.neonGlowLines) do
            line.Visible = false
        end
    end
end

local function destroyEspCache(entity, cache)
    pcall(function()
        if cache.box then
            cache.box.outline:Remove()
            cache.box.fill:Remove()

            for _, line in next, cache.box.grad_lines do
                line:Remove()
            end

            for _, line in next, cache.box.fill_grad_lines do
                line:Remove()
            end

            for _, line in next, cache.box.corner_fill do
                line:Remove()
            end

            for _, line in next, cache.box.corner_outline do
                line:Remove()
            end

            for _, line in next, cache.box.box_3d_lines do
                line:Remove()
            end
        end

        if cache.healthbar then
            cache.healthbar.background:Remove()

            for _, segment in ipairs(cache.healthbar.segments) do
                segment:Remove()
            end
        end

        if cache.healthtext then
            cache.healthtext:Remove()
        end

        if cache.name then
            cache.name:Remove()
        end

        if cache.distance then
            cache.distance:Remove()
        end

        if cache.tracer then
            cache.tracer.outline:Remove()
            cache.tracer.fill:Remove()
        end

        if cache.skeleton then
            for _, line in next, cache.skeleton.lines do
                line:Remove()
            end
        end

        if cache.weapon then
            cache.weapon:Remove()
        end

        if cache.circulartarget then
            for _, line in ipairs(cache.circulartarget.lines) do
                line:Remove()
            end

            for _, line in ipairs(cache.circulartarget.trailLines) do
                line:Remove()
            end

            for _, line in ipairs(cache.circulartarget.neonGlowLines) do
                line:Remove()
            end
        end

        if cache.partConnAdd then
            cache.partConnAdd:Disconnect()
        end

        if cache.partConnRemove then
            cache.partConnRemove:Disconnect()
        end

        if cache.sizeConns then
            for _, conn in next, cache.sizeConns do
                conn:Disconnect()
            end
        end
    end)
end

do
    local equippedCache = {}
    local equippedNameCache = {}

    local function getEquippedWeaponName(player)
        if not player then
            return "None"
        end

        local equippedJson = player:GetAttribute("CurrentEquipped")

        if equippedJson ~= equippedCache[player] then
            equippedCache[player] = equippedJson

            if equippedJson then
                local ok, decoded = pcall(function() return httpService:JSONDecode(equippedJson) end)
                equippedNameCache[player] = ok and decoded and decoded.Name or "None"
            else
                equippedNameCache[player] = "None"
            end
        end

        return equippedNameCache[player] or "None"
    end

    local function getCachedScreenPosition(cache, part)
        local cached = cache[part]

        if cached then
            return cached[1], cached[2]
        end

        local screenPos, onScreen = worldToViewportPoint(currentCamera, part.Position)
        local vector = Vector2.new(screenPos.X, screenPos.Y)
        cache[part] = { vector, onScreen }
        return vector, onScreen
    end

    runService.RenderStepped:Connect(function(delta)
        if esplib.box.fillRotation then
            rotationTime = (rotationTime + delta * (esplib.box.rotationSpeed or 2)) % twoPi
        end

        local cameraPos = currentCamera.CFrame.Position
        local viewportSize = currentCamera.ViewportSize
        local teamCheck = toggles.ESPTeamCheck and toggles.ESPTeamCheck.Value
        local rotationOffset = rotationTime / twoPi

        for entity, cache in next, espInstances do
            if not entity or not entity.Parent then
                destroyEspCache(entity, cache)
                espInstances[entity] = nil
                continue
            end

            if entity == localPlayer.Character then
                hideAllEsp(cache)
                continue
            end

            if entity:IsA("Model") and not entity.PrimaryPart then
                local head = entity:FindFirstChild("Head")

                local rootPart = entity:FindFirstChild("HumanoidRootPart")
                    or entity:FindFirstChild("Torso") or entity:FindFirstChild("UpperTorso")

                if head then
                    entity.PrimaryPart = head
                elseif rootPart then
                    entity.PrimaryPart = rootPart
                end
            end

            if teamCheck and isFriendlyTarget(entity) then
                hideAllEsp(cache)
                continue
            end

            local health = entity:GetAttribute("Health")
            local maxHealth = entity:GetAttribute("MaxHealth") or 100

            if entity:GetAttribute("Dead") == true or health and health <= 0 then
                hideAllEsp(cache)
                continue
            end

            local isBoxEnabled = esplib.box.enabled and cache.box ~= nil
            local isHealthbarEnabled = healthbar.enabled and cache.healthbar ~= nil
            local isHealthTextEnabled = healthtext.enabled and cache.healthtext ~= nil
            local isNameEnabled = esplib.name.enabled and cache.name ~= nil
            local isDistanceEnabled = distance.enabled and cache.distance ~= nil
            local isTracerEnabled = tracer.enabled and cache.tracer ~= nil
            local isSkeletonEnabled = skeleton.enabled and cache.skeleton ~= nil
            local isWeaponEnabled = weapon.enabled and cache.weapon ~= nil
            local isCircularTargetEnabled = circulartarget.enabled and cache.circulartarget ~= nil

            if cache.box and not isBoxEnabled then
                hideBox(cache.box)
            end

            if cache.healthbar and not isHealthbarEnabled then
                cache.healthbar.background.Visible = false

                for _, segment in ipairs(cache.healthbar.segments) do
                    segment.Visible = false
                end
            end

            if cache.healthtext and not isHealthTextEnabled then
                cache.healthtext.Visible = false
            end

            if cache.name and not isNameEnabled then
                cache.name.Visible = false
            end

            if cache.distance and not isDistanceEnabled then
                cache.distance.Visible = false
            end

            if cache.tracer and not isTracerEnabled then
                cache.tracer.outline.Visible = false
                cache.tracer.fill.Visible = false
            end

            if cache.skeleton and not isSkeletonEnabled then
                for _, line in ipairs(cache.skeleton.lines) do
                    line.Visible = false
                end
            end

            if cache.weapon and not isWeaponEnabled then
                cache.weapon.Visible = false
            end

            if cache.circulartarget then
                if not isCircularTargetEnabled then
                    for _, line in ipairs(cache.circulartarget.lines) do
                        line.Visible = false
                    end

                    for _, line in ipairs(cache.circulartarget.trailLines) do
                        line.Visible = false
                    end

                    for _, line in ipairs(cache.circulartarget.neonGlowLines) do
                        line.Visible = false
                    end
                end
            end

            if not (isBoxEnabled or isHealthbarEnabled or isHealthTextEnabled or isNameEnabled
                or isDistanceEnabled or isTracerEnabled or isSkeletonEnabled or isWeaponEnabled
                or isCircularTargetEnabled) then
                continue
            end

            local parts = getOrCreatePartList(entity, cache)
            local screenMin, screenMax, anyOnScreen = nil, nil, false
            local projectedCorners, cornersVisible = nil, false
            local minX, minY, minZ, maxX, maxY, maxZ = computeWorldBounds(parts)

            if minX then
                screenMin, screenMax, anyOnScreen = projectBoxToScreen(minX, minY, minZ, maxX, maxY, maxZ)

                if isBoxEnabled and esplib.box.type == "3D" then
                    projectedCorners, cornersVisible = projectCornersToScreen(minX, minY, minZ, maxX, maxY, maxZ)
                end
            end

            if cache.box then
                if isBoxEnabled and anyOnScreen and screenMin and screenMax then
                    local x, y = screenMin.X, screenMin.Y
                    local width = screenMax.X - screenMin.X
                    local height = screenMax.Y - screenMin.Y
                    local colorA = esplib.box.colorA
                    local colorB = esplib.box.colorB
                    local fillA = esplib.box.fillColorA
                    local fillB = esplib.box.fillColorB

                    if esplib.box.type == "2D" then
                        if esplib.box.fillGradient then
                            drawFillGradient(cache.box.fill_grad_lines, x, y, width, height, fillA, fillB, rotationTime)
                        else
                            for _, line in ipairs(cache.box.fill_grad_lines) do
                                line.Visible = false
                            end
                        end

                        drawBorderGradient(cache.box, x, y, width, height, colorA, colorB, rotationOffset)

                        cache.box.outline.Visible = false
                        cache.box.fill.Visible = false

                        for _, line in ipairs(cache.box.corner_fill) do
                            line.Visible = false
                        end

                        for _, line in ipairs(cache.box.corner_outline) do
                            line.Visible = false
                        end

                        for _, line in ipairs(cache.box.box_3d_lines) do
                            line.Visible = false
                        end
                    elseif esplib.box.type == "Corner" then
                        for _, line in ipairs(cache.box.grad_lines) do
                            line.Visible = false
                        end

                        cache.box.outline.Visible = false
                        cache.box.fill.Visible = false

                        if esplib.box.fillGradient then
                            drawFillGradient(cache.box.fill_grad_lines, x, y, width, height, fillA, fillB, rotationTime)
                        else
                            for _, line in ipairs(cache.box.fill_grad_lines) do
                                line.Visible = false
                            end
                        end

                        local cornerSize = math.min(width, height) * 0.25

                        local cornerSegments = {
                            { Vector2.new(x, y), Vector2.new(x + cornerSize, y) },
                            { Vector2.new(x, y), Vector2.new(x, y + cornerSize) },
                            { Vector2.new(x + width - cornerSize, y), Vector2.new(x + width, y) },
                            { Vector2.new(x + width, y), Vector2.new(x + width, y + cornerSize) },
                            { Vector2.new(x, y + height), Vector2.new(x + cornerSize, y + height) },
                            { Vector2.new(x, y + height - cornerSize), Vector2.new(x, y + height) },
                            { Vector2.new(x + width - cornerSize, y + height), Vector2.new(x + width, y + height) },
                            { Vector2.new(x + width, y + height - cornerSize), Vector2.new(x + width, y + height) },
                        }

                        for i = 1, 8 do
                            local color = lerpColor(colorA, colorB, (i - 1) / 8)

                            cache.box.corner_outline[i].From = cornerSegments[i][1]
                            cache.box.corner_outline[i].To = cornerSegments[i][2]
                            cache.box.corner_outline[i].Color = esplib.box.outline
                            cache.box.corner_outline[i].Visible = true
                            cache.box.corner_fill[i].From = cornerSegments[i][1]
                            cache.box.corner_fill[i].To = cornerSegments[i][2]
                            cache.box.corner_fill[i].Color = color
                            cache.box.corner_fill[i].Visible = true
                        end

                        for _, line in ipairs(cache.box.box_3d_lines) do
                            line.Visible = false
                        end
                    elseif esplib.box.type == "3D" then
                        for _, line in ipairs(cache.box.fill_grad_lines) do
                            line.Visible = false
                        end

                        for _, line in ipairs(cache.box.grad_lines) do
                            line.Visible = false
                        end

                        cache.box.outline.Visible = false
                        cache.box.fill.Visible = false

                        for _, line in ipairs(cache.box.corner_fill) do
                            line.Visible = false
                        end

                        for _, line in ipairs(cache.box.corner_outline) do
                            line.Visible = false
                        end

                        if projectedCorners and #projectedCorners == 8 then
                            for i = 1, 12 do
                                local edge = boxEdges[i]

                                cache.box.box_3d_lines[i].From = projectedCorners[edge[1]]
                                cache.box.box_3d_lines[i].To = projectedCorners[edge[2]]
                                cache.box.box_3d_lines[i].Color = lerpColor(colorA, colorB, (i - 1) / 12)
                                cache.box.box_3d_lines[i].Visible = cornersVisible
                            end
                        else
                            for _, line in ipairs(cache.box.box_3d_lines) do
                                line.Visible = false
                            end
                        end
                    end
                else
                    hideBox(cache.box)
                end
            end

            if cache.healthbar then
                local background = cache.healthbar.background
                local segments = cache.healthbar.segments

                if isHealthbarEnabled and anyOnScreen and screenMin and screenMax and health then
                    local barX = screenMin.X - 6
                    local barY = screenMin.Y
                    local barHeight = screenMax.Y - screenMin.Y
                    local healthRatio = clamp(health / (maxHealth > 0 and maxHealth or 100), 0, 1)

                    background.Position = Vector2.new(barX - 1, barY - 1)
                    background.Size = Vector2.new(5, barHeight + 2)
                    background.Visible = true

                    local fillHeight = barHeight * healthRatio
                    local fillTop = barY + (barHeight - fillHeight)
                    local segmentCount = math.clamp(math.floor(12 * healthRatio), 1, 12)
                    local segmentHeight = fillHeight / segmentCount

                    for i = 1, 12 do
                        local segment = segments[i]

                        if i <= segmentCount then
                            local t = (i - 0.5) / 12
                            segment.Color = lerpColor(healthbar.bottomColor, healthbar.topColor, t)
                            local y1 = fillTop + (i - 1) * segmentHeight
                            local y2 = fillTop + i * segmentHeight

                            segment.From = Vector2.new(barX + 1.5, y1)
                            segment.To = Vector2.new(barX + 1.5, y2)
                            segment.Thickness = 3
                            segment.Visible = true
                        else
                            segment.Visible = false
                        end
                    end
                else
                    background.Visible = false

                    for _, segment in ipairs(segments) do
                        segment.Visible = false
                    end
                end
            end

            if cache.healthtext then
                if isHealthTextEnabled and anyOnScreen and screenMin and screenMax and health then
                    local roundedHealth = math.floor(health + 0.5)
                    local maxH = maxHealth > 0 and maxHealth or 100

                    cache.healthtext.Text = tostring(roundedHealth)
                    cache.healthtext.Size = healthtext.size
                    cache.healthtext.Color = healthtext.color

                    local textX = screenMax.X + 4
                    local textY = screenMin.Y + (screenMax.Y - screenMin.Y) * (1 - health / maxH) - 4

                    cache.healthtext.Position = Vector2.new(textX, textY)
                    cache.healthtext.Visible = true
                else
                    cache.healthtext.Visible = false
                end
            end

            if cache.name then
                if isNameEnabled and anyOnScreen and screenMin and screenMax then
                    cache.name.Text = entity.Name
                    cache.name.Size = esplib.name.size
                    cache.name.Color = esplib.name.fill
                    cache.name.Position = Vector2.new((screenMin.X + screenMax.X) * 0.5, screenMin.Y - 15)
                    cache.name.Visible = true
                else
                    cache.name.Visible = false
                end
            end

            if cache.distance then
                if isDistanceEnabled and anyOnScreen and screenMin and screenMax then
                    local distanceValue = 999

                    if entity:IsA("Model") and entity.PrimaryPart then
                        distanceValue = (cameraPos - entity.PrimaryPart.Position).Magnitude
                    elseif entity:IsA("BasePart") then
                        distanceValue = (cameraPos - entity.Position).Magnitude
                    end

                    cache.distance.Text = tostring(floor(distanceValue)) .. "m"
                    cache.distance.Size = distance.size
                    cache.distance.Color = distance.color
                    cache.distance.Position = Vector2.new((screenMin.X + screenMax.X) * 0.5, screenMax.Y + 2)
                    cache.distance.Visible = true
                else
                    cache.distance.Visible = false
                end
            end

            if cache.weapon then
                if isWeaponEnabled and anyOnScreen and screenMin and screenMax then
                    if not cache.player then
                        cache.player = players:GetPlayerFromCharacter(entity)
                    end

                    local weaponName = cache.player and getEquippedWeaponName(cache.player) or "None"

                    cache.weapon.Text = "[" .. weaponName .. "]"
                    cache.weapon.Size = weapon.size or 13
                    cache.weapon.Color = weapon.fill
                    cache.weapon.Position = Vector2.new((screenMin.X + screenMax.X) * 0.5, screenMax.Y + 15)
                    cache.weapon.Center = true
                    cache.weapon.Visible = true
                else
                    cache.weapon.Visible = false
                end
            end

            if cache.tracer then
                if isTracerEnabled and anyOnScreen and screenMin and screenMax then
                    local origin

                    if tracer.from == "mouse" then
                        local mouse = userInputService:GetMouseLocation()
                        origin = Vector2.new(mouse.X, mouse.Y)
                    elseif tracer.from == "top" then
                        origin = Vector2.new(viewportSize.X / 2, 0)
                    elseif tracer.from == "center" then
                        origin = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
                    else
                        origin = Vector2.new(viewportSize.X / 2, viewportSize.Y)
                    end

                    local target = (screenMin + screenMax) / 2
                    local ratio = 0

                    if entity:IsA("Model") and entity.PrimaryPart then
                        ratio = clamp((cameraPos - entity.PrimaryPart.Position).Magnitude / 200, 0, 1)
                    end

                    local color = lerpColor(tracer.fillA, tracer.fillB, ratio)

                    cache.tracer.outline.From = origin
                    cache.tracer.outline.To = target
                    cache.tracer.outline.Color = tracer.outline
                    cache.tracer.outline.Visible = true
                    cache.tracer.fill.From = origin
                    cache.tracer.fill.To = target
                    cache.tracer.fill.Color = color
                    cache.tracer.fill.Visible = true
                else
                    cache.tracer.outline.Visible = false
                    cache.tracer.fill.Visible = false
                end
            end

            if cache.skeleton then
                if isSkeletonEnabled then
                    local boneParts = cache.skeleton.bone_parts
                    local lines = cache.skeleton.lines
                    local screenCache = cache.skeleton.screenCache

                    for key in next, screenCache do
                        screenCache[key] = nil
                    end

                    local anyVisible = false

                    for i = 1, #boneParts do
                        local bonePair = boneParts[i]
                        local partA, partB = bonePair[1], bonePair[2]
                        local line = lines[i]

                        if partA and partB and partA.Parent and partB.Parent then
                            local from, onScreenA = getCachedScreenPosition(screenCache, partA)
                            local to, onScreenB = getCachedScreenPosition(screenCache, partB)

                            if onScreenA or onScreenB then
                                line.From = from
                                line.To = to
                                line.Color = lerpColor(skeleton.colorA, skeleton.colorB, (i - 1) / #boneParts)
                                line.Thickness = skeleton.thickness
                                line.Visible = true

                                anyVisible = true
                            else
                                line.Visible = false
                            end
                        else
                            line.Visible = false
                        end
                    end

                    if not anyVisible then
                        for _, line in ipairs(lines) do
                            line.Visible = false
                        end
                    end
                else
                    for _, line in ipairs(cache.skeleton.lines) do
                        line.Visible = false
                    end
                end
            end

            if cache.circulartarget then
                local ctCache = cache.circulartarget
                local head = entity:FindFirstChild("Head")

                local primaryPart = entity:IsA("Model") and entity.PrimaryPart
                    or entity:FindFirstChild("HumanoidRootPart") or head

                if isCircularTargetEnabled and head and primaryPart then
                    if ctCache.movingUp then
                        ctCache.alpha = ctCache.alpha + delta * 2

                        if ctCache.alpha >= 1 then
                            ctCache.alpha = 1
                            ctCache.movingUp = false
                        end
                    else
                        ctCache.alpha = ctCache.alpha - delta * 2

                        if ctCache.alpha <= 0 then
                            ctCache.alpha = 0
                            ctCache.movingUp = true
                        end
                    end

                    local centerPos = (primaryPart.Position - Vector3.new(0, primaryPart.Size.Y * 0.8 + 1.2, 0)):Lerp(
                        head.Position + Vector3.new(0, 0.3, 0), ctCache.alpha
                    )

                    table.insert(ctCache.trailHistory, 1, centerPos)

                    if #ctCache.trailHistory > #ctCache.trailLines then
                        table.remove(ctCache.trailHistory)
                    end

                    for i = 1, #ctCache.trailLines do
                        local trailLine = ctCache.trailLines[i]
                        local glowLine = ctCache.neonGlowLines[i]
                        local posA = ctCache.trailHistory[i]
                        local posB = ctCache.trailHistory[i + 1]

                        if posA and posB then
                            local screenA, onA = worldToViewportPoint(currentCamera, posA)
                            local screenB, onB = worldToViewportPoint(currentCamera, posB)

                            if onA or onB then
                                local fade = clamp(1 - i / #ctCache.trailLines, 0.05, 1)

                                glowLine.From = Vector2.new(screenA.X, screenA.Y)
                                glowLine.To = Vector2.new(screenB.X, screenB.Y)
                                glowLine.Color = circulartarget.color
                                glowLine.Transparency = fade * 0.35
                                glowLine.Visible = true

                                trailLine.From = Vector2.new(screenA.X, screenA.Y)
                                trailLine.To = Vector2.new(screenB.X, screenB.Y)
                                trailLine.Color = circulartarget.color
                                trailLine.Transparency = fade * 0.85
                                trailLine.Visible = true
                            else
                                trailLine.Visible = false
                                glowLine.Visible = false
                            end
                        else
                            trailLine.Visible = false
                            glowLine.Visible = false
                        end
                    end

                    local segments = ctCache.segments
                    local color = circulartarget.color

                    for i = 1, segments do
                        local angleA = twoPi * ((i - 1) / segments)
                        local angleB = twoPi * (i / segments)
                        local posA = centerPos + Vector3.new(cos(angleA) * 2.2, 0, sin(angleA) * 2.2)
                        local posB = centerPos + Vector3.new(cos(angleB) * 2.2, 0, sin(angleB) * 2.2)
                        local screenA, onA = worldToViewportPoint(currentCamera, posA)
                        local screenB, onB = worldToViewportPoint(currentCamera, posB)
                        local line = ctCache.lines[i]

                        if onA or onB then
                            line.From = Vector2.new(screenA.X, screenA.Y)
                            line.To = Vector2.new(screenB.X, screenB.Y)
                            line.Color = color
                            line.Visible = true
                        else
                            line.Visible = false
                        end
                    end
                else
                    for _, line in ipairs(ctCache.lines) do
                        line.Visible = false
                    end

                    for _, line in ipairs(ctCache.trailLines) do
                        line.Visible = false
                    end

                    for _, line in ipairs(ctCache.neonGlowLines) do
                        line.Visible = false
                    end
                end
            end
        end
    end)

    for key, value in next, espApi do
        esplib[key] = value
    end
end

