local function drawFillGradient(lines, x, y, width, height, colorA, colorB, rotation)
    local cosR = cos(rotation)
    local sinR = sin(rotation)
    local centerX = x + width * 0.5
    local centerY = y + height * 0.5
    local projRadius = math.max((abs(cosR) * width + abs(sinR) * height) * 0.5, 1)
    local segments = math.clamp(math.floor(height * 0.8), 15, 400)
    local step = height / segments

    for i = 1, segments do
        local py = y + (i - 0.5) * step
        local projLeft = ((x - centerX) * cosR + (py - centerY) * sinR) / projRadius
        local projRight = ((x + width - centerX) * cosR + (py - centerY) * sinR) / projRadius
        local tLeft = clamp(projLeft * 0.5 + 0.5, 0, 1)
        local tRight = clamp(projRight * 0.5 + 0.5, 0, 1)

        local line = lines[i]
        line.Color = lerpColor(colorA, colorB, (tLeft + tRight) * 0.5)
        line.Thickness = math.clamp(step + 1.5, 2, 8)
        line.From = Vector2.new(x + 1, py)
        line.To = Vector2.new(x + width - 1, py)
        line.Visible = true
    end

    for i = segments + 1, #lines do
        lines[i].Visible = false
    end
end

local function drawBorderGradient(boxCache, x, y, width, height, colorA, colorB, rotationOffset)
    local gradLines = boxCache.grad_lines
    local count = 0

    local edges = {
        { x, y, x + width, y }, { x + width, y, x + width, y + height },
        { x + width, y + height, x, y + height }, { x, y + height, x, y },
    }

    for i = 1, 4 do
        local edge = edges[i]
        local x1, y1, x2, y2 = edge[1], edge[2], edge[3], edge[4]

        for j = 0, 3 do
            count = count + 1
            local t0 = j / 4
            local t1 = (j + 1) / 4
            local color = lerpColor(colorA, colorB, ((i - 1) / 4 + t0 / 4 + rotationOffset) % 1)
            local line = gradLines[count]

            if line then
                line.From = Vector2.new(x1 + (x2 - x1) * t0, y1 + (y2 - y1) * t0)
                line.To = Vector2.new(x1 + (x2 - x1) * t1, y1 + (y2 - y1) * t1)
                line.Color = color
                line.Visible = true
            end
        end
    end

    for i = count + 1, #gradLines do
        gradLines[i].Visible = false
    end
end

local function hideBox(boxCache)
    boxCache.outline.Visible = false
    boxCache.fill.Visible = false

    for _, line in ipairs(boxCache.grad_lines) do
        line.Visible = false
    end

    for _, line in ipairs(boxCache.fill_grad_lines) do
        line.Visible = false
    end

    for _, line in ipairs(boxCache.corner_fill) do
        line.Visible = false
    end

    for _, line in ipairs(boxCache.corner_outline) do
        line.Visible = false
    end

    for _, line in ipairs(boxCache.box_3d_lines) do
        line.Visible = false
    end
end

function espApi.add_box(entity)
    if not entity or espInstances[entity] and espInstances[entity].box then
        return
    end

    local function makeLine(thickness)
        local line = Drawing.new("Line")
        line.Thickness = thickness
        line.Transparency = 1
        line.Visible = false

        return line
    end

    local function makeSquare(thickness, filled)
        local square = Drawing.new("Square")
        square.Thickness = thickness
        square.Filled = filled
        square.Transparency = 1
        square.Visible = false

        return square
    end

    local cache = {}
    cache.outline = makeSquare(3, false)
    cache.fill = makeSquare(1, false)
    cache.grad_lines = {}

    for i = 1, 16 do
        cache.grad_lines[i] = makeLine(1)
    end

    cache.fill_grad_lines = createLineBuffer()
    cache.corner_fill = {}
    cache.corner_outline = {}

    for i = 1, 8 do
        cache.corner_fill[i] = makeLine(1)
        cache.corner_outline[i] = makeLine(3)
    end

    cache.box_3d_lines = {}

    for i = 1, 12 do
        cache.box_3d_lines[i] = makeLine(2)
    end

    espInstances[entity] = espInstances[entity] or {}
    espInstances[entity].box = cache
end

