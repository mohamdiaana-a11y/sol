        end

        return tabObj.Tabbox
    end

    local function makeGroupbox(tabObj, title, iconName)
        local host = nil
        local tabbox = getTabbox(tabObj)

        if tabbox then
            local okSub, sub = pcall(function()
                return tabbox:AddTab({ Name = stripTags(title), Icon = iconOf(iconName) })
            end)

            if okSub then
                host = sub
            end
        end

        host = host or tabObj.Raw

        -- Judul grup di atas setiap sub-tab, seperti header section di Evade.
        callHost(host, "AddDivider", { Text = stripTags(title) })

        local gb = { Host = host, Title = stripTags(title) }

        function gb:AddToggle(id, cfg)
            local entry = { Kind = "toggle", Value = cfg.Default == true, Callback = cfg.Callback, Changed = {} }
            registerMethods(entry, toggles, id)

            entry.Handle = callHost(host, "AddToggle", {
                Name = stripTags(cfg.Text),
                Default = entry.Value,
                Flag = makeFlag("T", gb.Title, stripTags(cfg.Text)),
                Description = cfg.Tooltip,
                Callback = function(value)
                    userSet(entry, value == true)
                end,
            })

            return entry
        end

        function gb:AddDropdown(id, cfg)
            local values = cfg.Values or {}
            local default = cfg.Default

            if type(default) == "number" then
                default = values[default]
            end

            if default == nil then
                default = values[1]
            end

            local entry = { Kind = "dropdown", Value = default, Values = values, Callback = cfg.Callback, Changed = {} }
            registerMethods(entry, options, id)

            entry.SetValues = function(_, list)
                entry.Values = list or {}
            end

            entry.Handle = callHost(host, "AddDropdown", {
                Name = stripTags(cfg.Text),
                Values = values,
                Default = default,
                Multi = false,
                Search = #values > 8,
                AllowNone = false,
                Flag = makeFlag("D", gb.Title, stripTags(cfg.Text)),
                Callback = function(value)
                    if type(value) == "table" then
                        value = value[1]
                    end

                    userSet(entry, value)
                end,
            })

            return entry
        end

        function gb:AddSlider(id, cfg)
            local rounding = cfg.Rounding or 0
            local increment = rounding > 0 and 10 ^ (-rounding) or 1
            local entry = { Kind = "slider", Value = cfg.Default or cfg.Min or 0, Callback = cfg.Callback, Changed = {} }
            registerMethods(entry, options, id)

            entry.Handle = callHost(host, "AddSlider", {
                Name = stripTags(cfg.Text),
                Min = cfg.Min or 0,
                Max = cfg.Max or 100,
                Default = entry.Value,
                Increment = increment,
                Rounding = rounding,
                Unit = unitOf(cfg.Suffix),
                Flag = makeFlag("S", gb.Title, stripTags(cfg.Text)),
                Callback = function(value)
                    userSet(entry, value)
                end,
            })

            return entry
        end

        function gb:AddInput(id, cfg)
            local entry = { Kind = "input", Value = cfg.Default or "", Callback = cfg.Callback, Changed = {} }
            registerMethods(entry, options, id)

            entry.Handle = callHost(host, "AddTextInput", {
                Name = stripTags(cfg.Text),
                Placeholder = cfg.Placeholder or "",
                Default = entry.Value,
                Flag = makeFlag("I", gb.Title, stripTags(cfg.Text)),
                Callback = function(text)
                    userSet(entry, tostring(text or ""))
                end,
            })

            return entry
        end

        function gb:AddLabel(a)
            local cfg = type(a) == "table" and a or { Text = a }

            callHost(host, "AddParagraph", {
                Name = stripTags(cfg.Text),
                Title = stripTags(cfg.Text),
                Content = "",
                Description = "",
