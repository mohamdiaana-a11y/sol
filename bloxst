        pcall(function()
            local character = localPlayer.Character

            if not character then
                return
            end

            local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
            local humanoid = character:FindFirstChild("Humanoid")

            if not humanoidRootPart or not humanoid then
                return
            end

            if toggles.AutoBhop and toggles.AutoBhop.Value then
                if userInputService:IsKeyDown(Enum.KeyCode.Space) then
                    local groundCheck = RaycastParams.new()
                    groundCheck.FilterDescendantsInstances = { character }
                    groundCheck.FilterType = Enum.RaycastFilterType.Exclude

                    if workspaceRef:Raycast(humanoidRootPart.Position, Vector3.new(0, -4, 0), groundCheck) then
                        humanoid.Jump = true
                    end
                end

                local success, direction = pcall(getMovementDirection)

                if success and direction.Magnitude > 0 then
                    local targetVelocity = direction
                        * math.clamp(options.BhopSpeed and options.BhopSpeed.Value or 18, 5, 30)

                    local currentVelocity = humanoidRootPart.AssemblyLinearVelocity
                    local newX = currentVelocity.X + (targetVelocity.X - currentVelocity.X) * 0.2
                    local newZ = currentVelocity.Z + (targetVelocity.Z - currentVelocity.Z) * 0.2

                    humanoidRootPart.AssemblyLinearVelocity = Vector3.new(
                        newX, currentVelocity.Y, newZ
                    )
                end
            end
        end)
    end)

