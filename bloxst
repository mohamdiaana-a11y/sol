local partSizeCache = setmetatable({}, { __mode = "k" })

local function getPartHalfSize(part)
    local cached = partSizeCache[part]

    if not cached then
        local size = part.Size
        cached = { hx = size.X * 0.5, hy = size.Y * 0.5, hz = size.Z * 0.5 }
        partSizeCache[part] = cached
    end

    return cached.hx, cached.hy, cached.hz
end

local function computeWorldBounds(parts)
    local minX, minY, minZ = math.huge, math.huge, math.huge
    local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge

    for i = 1, #parts do
        local part = parts[i]
        local hx, hy, hz = getPartHalfSize(part)
        local px, py, pz, r00, r01, r02, r10, r11, r12, r20, r21, r22 = part.CFrame:GetComponents()
        local extentX = abs(r00) * hx + abs(r01) * hy + abs(r02) * hz
        local extentY = abs(r10) * hx + abs(r11) * hy + abs(r12) * hz
        local extentZ = abs(r20) * hx + abs(r21) * hy + abs(r22) * hz

        if px - extentX < minX then minX = px - extentX end
        if py - extentY < minY then minY = py - extentY end
        if pz - extentZ < minZ then minZ = pz - extentZ end
        if px + extentX > maxX then maxX = px + extentX end
        if py + extentY > maxY then maxY = py + extentY end
        if pz + extentZ > maxZ then maxZ = pz + extentZ end
    end

    if minX == math.huge then
        return nil
    end

    return minX, minY, minZ, maxX, maxY, maxZ
end

local function projectBoxToScreen(minX, minY, minZ, maxX, maxY, maxZ)
    local screenMinX, screenMinY = math.huge, math.huge
    local screenMaxX, screenMaxY = -math.huge, -math.huge
    local anyOnScreen = false

    for i = 1, 8 do
        local corner = boxCorners[i]
        local x = corner[1] == 0 and minX or maxX
        local y = corner[2] == 0 and minY or maxY
        local z = corner[3] == 0 and minZ or maxZ
        local screenPos, onScreen = worldToViewportPoint(currentCamera, Vector3.new(x, y, z))

        if onScreen then
            anyOnScreen = true
        end

        if screenPos.X < screenMinX then screenMinX = screenPos.X end
        if screenPos.Y < screenMinY then screenMinY = screenPos.Y end
        if screenPos.X > screenMaxX then screenMaxX = screenPos.X end
        if screenPos.Y > screenMaxY then screenMaxY = screenPos.Y end
    end

    if screenMinX == math.huge then
        return nil, nil, false
    end

    return Vector2.new(screenMinX, screenMinY), Vector2.new(screenMaxX, screenMaxY), anyOnScreen
end

local function projectCornersToScreen(minX, minY, minZ, maxX, maxY, maxZ)
    local corners = {}
    local anyOnScreen = false

    for i = 1, 8 do
        local corner = boxCorners[i]
        local x = corner[1] == 0 and minX or maxX
        local y = corner[2] == 0 and minY or maxY
        local z = corner[3] == 0 and minZ or maxZ
        local screenPos, onScreen = worldToViewportPoint(currentCamera, Vector3.new(x, y, z))
        corners[i] = Vector2.new(screenPos.X, screenPos.Y)

        if onScreen then
            anyOnScreen = true
        end
    end

    return corners, anyOnScreen
end

local function getOrCreatePartList(entity, cache)
    if cache.partlist then
        return cache.partlist
    end

    local list = {}
    local indexMap = setmetatable({}, { __mode = "k" })

    local function addPart(part)
        if part:IsA("BasePart") and not indexMap[part] then
            list[#list + 1] = part
            indexMap[part] = #list
            local conn = part:GetPropertyChangedSignal("Size"):Connect(function()
                partSizeCache[part] = nil
            end)

            cache.sizeConns = cache.sizeConns or {}
            cache.sizeConns[part] = conn
        end
    end

    local function removePart(part)
        local index = indexMap[part]

        if not index then
            return
        end

        local last = #list
        local lastPart = list[last]
        list[index] = lastPart
        indexMap[lastPart] = index
        list[last] = nil
        indexMap[part] = nil

        if cache.sizeConns and cache.sizeConns[part] then
            cache.sizeConns[part]:Disconnect()
            cache.sizeConns[part] = nil
        end
    end

    if entity:IsA("Model") then
        for _, descendant in next, entity:GetDescendants() do
            addPart(descendant)
        end

        cache.partConnAdd = entity.DescendantAdded:Connect(addPart)
        cache.partConnRemove = entity.DescendantRemoving:Connect(removePart)
    elseif entity:IsA("BasePart") then
        addPart(entity)
    end

    cache.partlist = list
    return list
end

