local espObjects = {}
local tracers = {}

local function removeEsp(player)
    local object = espObjects[player]

    if object then
        pcall(function()
            object.highlight:Destroy()
            object.billboard:Destroy()
        end)

        espObjects[player] = nil
    end
end

local function applyEsp(player)
    if player == localPlayer then
        return
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not character or not root then
        removeEsp(player)
        return
    end

    local object = espObjects[player]

    if object and object.character == character then
        return
    end

    removeEsp(player)

    local highlight = Instance.new("Highlight")
    highlight.Adornee = character
    highlight.FillColor = Color3.fromRGB(255, 60, 60)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.6
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character

    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = character:FindFirstChild("Head") or root
    billboard.Size = UDim2.fromOffset(160, 30)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = character

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0
    label.Text = player.DisplayName
    label.Parent = billboard

    espObjects[player] = {
        character = character,
        highlight = highlight,
        billboard = billboard,
        label = label,
    }
end

local function clearAllEsp()
    for player in pairs(espObjects) do
        removeEsp(player)
    end
end

local function getTracer(player)
    if not tracers[player] then
        local line = newDrawing("Line")

        if line then
            line.Thickness = 1.5
            line.Color = Color3.fromRGB(255, 255, 255)
        end

        tracers[player] = line
    end

    return tracers[player]
end

task.spawn(function()
    while alive do
        if S.ESP then
            for _, player in ipairs(players:GetPlayers()) do
                if isEnemy(player) then
                    applyEsp(player)
                else
                    removeEsp(player)
                end
            end
        elseif next(espObjects) then
            clearAllEsp()
        end

        task.wait(0.5)
    end
end)

track(runService.RenderStepped:Connect(function()
    if not alive then
        return
    end

    local camera = workspace.CurrentCamera
    local viewport = camera.ViewportSize

    for _, object in pairs(espObjects) do
        local root = object.character and object.character:FindFirstChild("HumanoidRootPart")
        local localRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")

        if object.label and root and localRoot then
            local distance = math.floor((root.Position - localRoot.Position).Magnitude)
            local name = object.label.Text:match("^(.-) %[") or object.label.Text
            object.label.Text = name .. " [" .. distance .. "m]"
        end
    end

    if S.Tracer then
        for _, player in ipairs(players:GetPlayers()) do
            if isEnemy(player) then
                getTracer(player)
            end
        end
    end

    for _, player in ipairs(players:GetPlayers()) do
        local line = tracers[player]

        if line then
            local part = S.Tracer and isEnemy(player) and getAliveHead(player)

            if part then
                local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
                line.From = Vector2.new(viewport.X / 2, viewport.Y)
                line.To = Vector2.new(screenPos.X, screenPos.Y)
                line.Visible = onScreen and screenPos.Z > 0
            else
                line.Visible = false
            end
        end
    end
end))

players.PlayerRemoving:Connect(function(player)
