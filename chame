local function makeControls(host, scope)
    local api = {}

    function api:Toggle(key, text, default, callback)
        S[key] = default == true

        callHost(host, "AddToggle", {
            Name = text,
            Default = S[key],
            Flag = makeFlag("T", scope, text),
            Callback = function(value)
                S[key] = value == true

                if callback then
                    pcall(callback, S[key])
                end
            end,
        })
    end

    function api:Slider(key, text, min, max, default, step, decimals, callback)
        S[key] = default

        callHost(host, "AddSlider", {
            Name = text,
            Min = min,
            Max = max,
            Default = default,
            Increment = step,
            Rounding = decimals,
            Flag = makeFlag("S", scope, text),
            Callback = function(value)
                S[key] = value

                if callback then
                    pcall(callback, value)
                end
            end,
        })
    end

    function api:Dropdown(key, text, values, default, callback)
        S[key] = default

        callHost(host, "AddDropdown", {
            Name = text,
            Values = values,
            Default = default,
            Multi = false,
            Search = #values > 8,
            AllowNone = false,
            Flag = makeFlag("D", scope, text),
            Callback = function(value)
                if type(value) == "table" then
                    value = value[1]
                end

                S[key] = value

                if callback then
                    pcall(callback, value)
                end
            end,
        })
    end

    function api:Button(text, fn)
        callHost(host, "AddButton", {
            Name = text,
            Callback = function()
                task.spawn(pcall, fn)
            end,
        })
    end

    return api
end

local function newTab(name, icon)
    local tab = window:AddTab({ Name = name, Icon = iconOf(icon), Type = "Single" })

    if not tab then
        error("Gagal membuat tab: " .. tostring(name))
    end

    local obj = { Name = name, Raw = tab, Box = nil }

    function obj:Group(title, groupIcon)
        if not self.Box then
            local okBox, box = pcall(function()
                return self.Raw:AddCenterTabbox(self.Name)
            end)

            if okBox and box then
                self.Box = box
            end
        end

        local host = self.Raw

        if self.Box then
            local okSub, sub = pcall(function()
                return self.Box:AddTab({ Name = title, Icon = iconOf(groupIcon) })
            end)

            if okSub and sub then
                host = sub
            end
        end

        callHost(host, "AddDivider", { Text = title })

        return makeControls(host, title)
    end

    return obj
end

