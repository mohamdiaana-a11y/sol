getgenv().SolanaHubChameleonUnload = function()
    if not alive then
        return
    end

    alive = false

    for _, connection in ipairs(connections) do
        pcall(function() connection:Disconnect() end)
    end

    setNoclip(false)
    clearAllEsp()

    for _, line in pairs(tracers) do
        pcall(function() line:Remove() end)
    end

    for _, object in ipairs(drawings) do
        pcall(function() object:Remove() end)
    end

    getgenv().SolanaHubChameleon = nil
    getgenv().SolanaHubChameleonUnload = nil

    pcall(function()
        if type(modern.Unload) == "function" then
            modern:Unload()
        end
    end)
end

