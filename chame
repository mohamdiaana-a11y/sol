local function iconOf(name)
    name = tostring(name or "layers")

    if name:find(":") then
        return name
    end

    return "lucide:" .. name
end

local function callHost(host, method, cfg)
    local fn = host and host[method]

    if type(fn) ~= "function" then
        return nil
    end

    local ok, result = pcall(fn, host, cfg)

    if not ok then
        warn("[Solana Hub] " .. method .. " gagal: " .. tostring(result))
        return nil
    end

    return result
end

local flagCounts = {}

local function makeFlag(prefix, scope, title)
    local base = prefix .. ":" .. tostring(scope) .. "/" .. title
    flagCounts[base] = (flagCounts[base] or 0) + 1

    if flagCounts[base] > 1 then
        base = base .. "#" .. flagCounts[base]
    end

    return base
end

