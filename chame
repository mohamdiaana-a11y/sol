end

local crossDot = newDrawing("Circle")
local crossRing = newDrawing("Circle")

if crossDot then
    crossDot.Filled = true
    crossDot.Color = Color3.fromRGB(255, 255, 255)
    crossDot.Visible = false
end

if crossRing then
    crossRing.Filled = false
    crossRing.Thickness = 2
    crossRing.NumSides = 48
    crossRing.Color = Color3.fromRGB(255, 255, 255)
    crossRing.Visible = false
end

local function hideCrosshair()
    for _, line in ipairs(crossLines) do
        if line then
            line.Visible = false
        end
    end

    if crossDot then
        crossDot.Visible = false
    end

    if crossRing then
        crossRing.Visible = false
    end
end

local function drawCrosshair(center)
    local size = S.CrosshairSize
    local style = S.CrosshairStyle
    local half = size / 2
    local gap = 4

    local function setLine(index, fromPoint, toPoint)
        local line = crossLines[index]

        if line then
            line.From = fromPoint
            line.To = toPoint
            line.Visible = true
        end
    end

    local function hideLines()
        for _, line in ipairs(crossLines) do
            if line then
                line.Visible = false
            end
        end
    end

    hideLines()

    if crossDot then
        crossDot.Visible = style == "Dot" or style == "Scope"
        crossDot.Position = center
        crossDot.Radius = 2.5
    end

    if crossRing then
        crossRing.Visible = style == "Circle" or style == "Scope"
        crossRing.Position = center
        crossRing.Radius = half
    end

    if style == "Plus" or style == "Scope" then
        setLine(1, center + Vector2.new(-half, 0), center + Vector2.new(-gap, 0))
        setLine(2, center + Vector2.new(gap, 0), center + Vector2.new(half, 0))
        setLine(3, center + Vector2.new(0, -half), center + Vector2.new(0, -gap))
        setLine(4, center + Vector2.new(0, gap), center + Vector2.new(0, half))
    elseif style == "Cross" then
        local d = half * 0.7071
        setLine(1, center + Vector2.new(-d, -d), center + Vector2.new(-gap * 0.7, -gap * 0.7))
        setLine(2, center + Vector2.new(gap * 0.7, gap * 0.7), center + Vector2.new(d, d))
        setLine(3, center + Vector2.new(d, -d), center + Vector2.new(gap * 0.7, -gap * 0.7))
        setLine(4, center + Vector2.new(-gap * 0.7, gap * 0.7), center + Vector2.new(-d, d))
    end
end

track(runService.RenderStepped:Connect(function()
    if not alive then
        return
    end

    local camera = workspace.CurrentCamera
    local center = camera.ViewportSize / 2

    if fovCircle then
        fovCircle.Position = center
        fovCircle.Radius = S.AimRadius
        fovCircle.Visible = S.ShowFov and (S.AimbotV1 or S.AimbotV2)
    end

    if S.Crosshair then
        drawCrosshair(center)
    else
        hideCrosshair()
    end
end))

