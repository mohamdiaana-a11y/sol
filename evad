    local function makeFlag(prefix, scope, title)
        local base = prefix .. ":" .. scope .. "/" .. title
        flagCounts[base] = (flagCounts[base] or 0) + 1

        if flagCounts[base] > 1 then
            base = base .. "#" .. flagCounts[base]
        end

        return base
    end

    local function applyValue(instance, value)
        if type(instance) ~= "table" then
            return false
        end

        for _, method in ipairs({ "SetValue", "Set", "Select" }) do
            local fn = instance[method]

            if type(fn) == "function" then
                if pcall(fn, instance, value) then
                    return true
                end
            end
        end

        return false
    end

    local function applyText(instance, title, text)
        if type(instance) ~= "table" then
            return
        end

        for _, method in ipairs({ "SetContent", "SetDescription", "SetText", "Set", "Update", "SetValue" }) do
            local fn = instance[method]

            if type(fn) == "function" then
                local ok

                if method == "Set" or method == "Update" then
                    ok = pcall(fn, instance, { Name = title, Title = title, Content = text, Description = text, Text = text })
                else
                    ok = pcall(fn, instance, text)
                end

                if ok then
                    return
                end
            end
        end
    end

    local function wrapHost(host, sectionName, withHeader)
        local section = {}
        local pendingHeader = withHeader and sectionName or nil

        local function header()
            if pendingHeader then
                local text = pendingHeader
                pendingHeader = nil
                pcall(function() host:AddDivider({ Text = text }) end)
            end
        end

        local function attachTip(instance, title, desc)
            desc = desc and tostring(desc) or ""

            if desc == "" or type(instance) ~= "table" then
                return
            end

            local root = instance.Root

            if typeof(root) ~= "Instance" then
                return
            end

            pcall(function()
                instance.Tip = modern:CreateToolTips(root, title, desc)
            end)
        end

        function section:AddParagraph(cfg)
            header()

            local title = stripTags(cfg.Title)
            local content = tostring(cfg.Content or cfg.Description or "")
            local handle = { Text = content }

            local didAdd, instance = pcall(function()
                return host:AddParagraph({
                    Name = title,
                    Title = title,
                    Content = content,
                    Description = content,
                    Text = content,
                })
            end)

            handle.Instance = didAdd and instance or nil

            function handle:SetDescription(text)
                text = tostring(text or "")

                if text == handle.Text then
                    return
                end

                handle.Text = text
                applyText(handle.Instance, title, text)
            end

            return handle
        end

        function section:AddToggle(cfg)
            header()

            local title = stripTags(cfg.Title)
            local default = cfg.Default == true
            local handle = { Value = default }
            local isReady = false

            local didAdd, instance = pcall(function()
                local options = {
                    Name = title,
                    Default = default,
                    Flag = makeFlag("T", sectionName, title),
                    Callback = function(value)
                        handle.Value = value == true

                        if not isReady then
                            return
                        end

                        if type(cfg.Callback) == "function" then
                            task.spawn(pcall, cfg.Callback, handle.Value)
                        end
                    end,
                }

                if cfg.Description then
                    options.Tooltip = cfg.Description
                end

                return host:AddToggle(options)
            end)

            handle.Instance = didAdd and instance or nil
            attachTip(handle.Instance, title, cfg.Description)

            task.delay(0.4, function() isReady = true end)

            function handle:Set(value)
                handle.Value = value == true
                applyValue(handle.Instance, handle.Value)
            end

            function handle:Get()
                return handle.Value
            end

            return handle
        end

        function section:AddButton(cfg)
            header()

            local title = stripTags(cfg.Title)
            local handle = {}

            local didAdd, instance = pcall(function()
                return host:AddButton({
                    Name = title,
                    ToolTip = cfg.Description,
                    Tooltip = cfg.Description,
                    Callback = function()
                        if type(cfg.Callback) == "function" then
                            task.spawn(pcall, cfg.Callback)
                        end
                    end,
                })
            end)

            handle.Instance = didAdd and instance or nil

            return handle
        end

        function section:AddDropdown(cfg)
            header()

            local title = stripTags(cfg.Title)
            local values = {}

            for _, option in ipairs(cfg.Options or cfg.Values or {}) do
                values[#values + 1] = tostring(option)
            end

            local default = cfg.Default

            if type(default) == "table" then
                default = default[1]
            end

            local handle = { Value = default }

            local didAdd, instance = pcall(function()
                return host:AddDropdown({
                    Name = title,
                    Values = values,
                    Default = default,
                    Multi = false,
                    Search = #values > 8,
                    AllowNone = false,
                    Tooltip = cfg.Description,
                    Flag = makeFlag("D", sectionName, title),
                    Callback = function(value)
                        if type(value) == "table" then
                            value = value[1]
                        end

                        handle.Value = value

                        if type(cfg.Callback) == "function" then
                            task.spawn(pcall, cfg.Callback, value)
                        end
                    end,
