local selectedEmoteIdx = nil
local activeVisualTrack = nil
local emoteSoundWatcherConnection = nil
local isPlayingVisualEmote = false
local visualEmoteGeneration = 0
local characterWatcherConnections = {}
local humanoidWatcherConnections = {}
local isHumanoidEmoting = false

local function disconnectAll(connectionList)
    for _, connection in ipairs(connectionList) do
        pcall(function() connection:Disconnect() end)
    end

    table.clear(connectionList)
end

local function getPlayerStateAttribute()
    local gameFolder = workspace:FindFirstChild("Game")
    local playersFolder = gameFolder and gameFolder:FindFirstChild("Players")
    local playerModel = playersFolder and playersFolder:FindFirstChild(localPlayer.Name)

    if not playerModel then
        return nil
    end

    return playerModel:GetAttribute("State")
end

local function isEmoteState(state)
    return state == "Emoting" or state == "EmotingSlide" or state == "Emote"
end

local function checkIsEmoting()
    if isHumanoidEmoting then
        return true
    end

    local success, state = pcall(getPlayerStateAttribute)

    return success and isEmoteState(state)
end

local function stopVisualEmote()
    visualEmoteGeneration = visualEmoteGeneration + 1

    if activeVisualTrack then
        pcall(function() activeVisualTrack:Stop(0) end)
        activeVisualTrack = nil
    end

    if emoteSoundWatcherConnection then
        pcall(function() emoteSoundWatcherConnection:Disconnect() end)
        emoteSoundWatcherConnection = nil
    end
end

local function resetEmoteState()
    stopVisualEmote()
    isHumanoidEmoting = false
    isPlayingVisualEmote = false
end

local function watchEmoteCharacter(character)
    disconnectAll(humanoidWatcherConnections)

    if not character then
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        table.insert(humanoidWatcherConnections, humanoid.Died:Connect(resetEmoteState))
    end

    table.insert(humanoidWatcherConnections, character.AncestryChanged:Connect(function(_, newParent)
        if not newParent then
            resetEmoteState()
        end
    end))
end

local function playVisualEmote(humanoid, animator, currentAnimationId)
    if isPlayingVisualEmote or not selectedEmoteIdx then
        return
    end

    local emoteEntry = emoteVisualList[selectedEmoteIdx]

    if not emoteEntry or emoteEntry.animId == "" or emoteEntry.animId == currentAnimationId then
        return
    end

    isPlayingVisualEmote = true
    stopVisualEmote()
    local currentGeneration = visualEmoteGeneration

    pcall(function()
        local parentModel = humanoid.Parent.Parent

        if parentModel then
            for _, descendant in ipairs(parentModel:GetDescendants()) do
                if descendant:IsA("Sound") and descendant.IsPlaying then
                    descendant:Stop()
                end
            end
        end
    end)

    pcall(function()
        local playersFolder = workspace:FindFirstChild("Players")
        local playerModel = playersFolder and playersFolder:FindFirstChild(localPlayer.Name)

        if playerModel then
            local rootPart = playerModel:FindFirstChild("HumanoidRootPart")
            local soundPos = rootPart and rootPart:FindFirstChild("SoundPos")

            if soundPos then
                for _, sound in ipairs(soundPos:GetChildren()) do
                    if sound:IsA("Sound") and sound.Name == "EmoteSound" then
                        pcall(function() sound:Stop() end)
                    end
                end
            end

            emoteSoundWatcherConnection = playerModel.DescendantAdded:Connect(function(descendant)
                if descendant:IsA("Sound") and descendant.Name == "EmoteSound" then
                    task.defer(function() pcall(function() descendant:Stop() end) end)
                end
            end)
        end
    end)

    pcall(function()
        local parentModel = humanoid.Parent.Parent

        if parentModel then
            for _, child in ipairs(parentModel:GetChildren()) do
                if child:IsA("Model") and child ~= parentModel:FindFirstChildOfClass("Humanoid") then
                    child:Destroy()
                end
            end
        end
    end)

    pcall(function() animator:Stop(0) end)

    local animation = Instance.new("Animation")
    animation.AnimationId = emoteEntry.animId

    local loadSuccess, animationTrack = pcall(function() return humanoid:LoadAnimation(animation) end)

    if loadSuccess and animationTrack then
        if currentGeneration ~= visualEmoteGeneration then
            pcall(function()
                animationTrack:Stop(0)
                animation:Destroy()
            end)

            task.defer(function() isPlayingVisualEmote = false end)
            return
        end

        activeVisualTrack = animationTrack
        animationTrack.Priority = Enum.AnimationPriority.Action

        if emoteEntry.label == "Ghoulish Galleon" then
            animationTrack.Looped = true
        end

        animationTrack:Play()

        animationTrack.Stopped:Connect(function()
            pcall(function() animation:Destroy() end)

            if activeVisualTrack == animationTrack then
                activeVisualTrack = nil
            end
        end)
    end

    task.defer(function() isPlayingVisualEmote = false end)
end

local function onAnimationPlayed(humanoid, animationTrack)
    if not S.EmoteVisualEnabled or not selectedEmoteIdx or isPlayingVisualEmote then
        return
    end

    local animationId = animationTrack.Animation and animationTrack.Animation.AnimationId

    if not animationId then
        return
    end

    if ignoredAnimationIds[animationId] then
        if activeVisualTrack then
            task.spawn(stopVisualEmote)
        end

        return
    end

    if checkIsEmoting() then
        playVisualEmote(humanoid, animationTrack, animationId)
        return
    end

    task.spawn(function()
        for _ = 1, 12 do
            task.wait(0.05)

            if isPlayingVisualEmote then
                return
            end

            if checkIsEmoting() then
                playVisualEmote(humanoid, animationTrack, animationId)
                return
            end
        end
    end)
end

local function bindAnimatorConnections(humanoidAnimator, controllerAnimator)
    disconnectAll(characterWatcherConnections)

    if humanoidAnimator then
        table.insert(characterWatcherConnections, humanoidAnimator.AnimationPlayed:Connect(function(animationTrack)
            onAnimationPlayed(humanoidAnimator, animationTrack)
        end))
    end

    if controllerAnimator then
        table.insert(characterWatcherConnections, controllerAnimator.AnimationPlayed:Connect(function(animationTrack)
            onAnimationPlayed(controllerAnimator, animationTrack)
        end))
    end
end

local function getRigAnimators()
    local rigsFolder = workspace:FindFirstChild("Rigs")
    local rig = rigsFolder and rigsFolder:FindFirstChild(localPlayer.Name)

    if not rig then
