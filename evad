-- ---- Auto Ticket ----
-- Teleport ke setiap ticket di workspace.Effects.Tickets, dengan jeda 0.2 detik per ticket.
loop(0.1, function()
    if not S.AutoTicketEnabled then
        return
    end

    local _, humanoid, root = getCharacterParts()
    local effects = workspace:FindFirstChild("Effects")
    local tickets = effects and effects:FindFirstChild("Tickets")

    if not root or not humanoid or humanoid.Health <= 0 or not tickets then
        return
    end

    for _, ticket in ipairs(tickets:GetChildren()) do
        if not S.AutoTicketEnabled then
            break
        end

        local ticketRoot = ticket:FindFirstChild("HumanoidRootPart")

        if ticketRoot and ticket.Parent then
            root.CFrame = ticketRoot.CFrame
            task.wait(0.2)
        end
    end
end)

do
    local setPlayerModeRemote = nil
    local characterRegistry = nil
    local lastForceSpawnTick = 0

    local function getSetPlayerModeRemote()
        if setPlayerModeRemote then
            return setPlayerModeRemote
        end

        local success, remote = pcall(function()
            return replicatedStorage:WaitForChild("Events", 10):WaitForChild("SetPlayerMode", 5)
        end)

        if success and remote then
            setPlayerModeRemote = remote
        end

        return setPlayerModeRemote
    end

    local function findCharacterRegistry()
        if characterRegistry then
            return characterRegistry
        end

        local success, gcObjects = pcall(getgc, true)

        if not success or not gcObjects then
            return nil
        end

        for i = 1, #gcObjects do
            local object = gcObjects[i]

            if type(object) == "table" then
                local ok, getCharacters = pcall(rawget, object, "GetCharacters")

                if ok and getCharacters then
                    characterRegistry = object
                    return object
                end
            end
        end

        return nil
    end

    loop(0.2, function()
        if not S.AutoForceSpawnEnabled then
            return
        end

        local now = tick()

        if now - lastForceSpawnTick < 3 then
            return
        end

        local registry = findCharacterRegistry()

        if not registry then
            return
        end

        local success, characters = pcall(function() return registry:GetCharacters() end)

        if not success or not characters then
            characterRegistry = nil
            return
        end

        for i = 1, #characters do
            local entry = characters[i]

            if type(entry) == "table" and entry.Done and entry.Local then
                local stateSuccess, isDowned = pcall(function()
                    return entry.State and entry.State.State == "Downed"
                end)

                if stateSuccess and isDowned then
                    lastForceSpawnTick = now
                    local remote = getSetPlayerModeRemote()

                    if remote then
                        pcall(function() remote:FireServer(true) end)
                    end
                end

                break
            end
        end
    end)
end

