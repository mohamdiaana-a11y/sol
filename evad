local function flatLook()
    local camera = workspace.CurrentCamera

    if not camera then
        return nil
    end

    local look = camera.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)

    if flat.Magnitude > 0 then
        flat = flat.Unit
    end

    return flat
end

