local Keybinds = {}
local KeybindConnections = {}

local function bindKeybind(name)
    if KeybindConnections[name] then
        KeybindConnections[name]:Disconnect()
        KeybindConnections[name] = nil
    end

    local keyName = Keybinds[name]

    if not keyName or keyName == "" then
        return
    end

    local didFind, keyCode = pcall(function() return Enum.KeyCode[keyName] end)

    if not didFind or not keyCode then
        return
    end

    KeybindConnections[name] = userInputService.InputBegan:Connect(function(input, isProcessed)
        if isProcessed then
            return
        end

        if input.KeyCode == keyCode then
            local feature = Features[name]

            if feature then
                setFeature(name, not S[feature.Key])
            end
        end
    end)
end

