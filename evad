-- ---- Auto Trimp ----
local trimp = { lastTick = tick(), airAccumulator = 0, wasAir = false, activeBV = nil, currentSpeed = 50, connection = nil }
local TRIMP_MAX_EXTRA = 100

local function getSpeedometerLabel()
    local success, label = pcall(function()
        return localPlayer.PlayerGui.Shared.HUD.Overlay.Default.CharacterInfo.Item.Speedometer.Players
    end)

    return success and label or nil
end

local function stopAutoTrimp()
    if trimp.connection then
        trimp.connection:Disconnect()
        trimp.connection = nil
    end

    if trimp.activeBV then
        trimp.activeBV:Destroy()
        trimp.activeBV = nil
    end

    trimp.currentSpeed = S.AutoTrimpSpeed
    trimp.airAccumulator = 0
    trimp.wasAir = false
end

local function updateAutoTrimp()
    local now = tick()
    local deltaTime = now - trimp.lastTick
    trimp.lastTick = now

    local _, humanoid, root = getCharacterParts()

    if not humanoid or not root then
        return
    end

    local base = S.AutoTrimpSpeed
    local label = getSpeedometerLabel()
    local isInAir = humanoid.FloorMaterial == Enum.Material.Air

    if trimp.wasAir and not isInAir then
        trimp.currentSpeed = math.max(base, trimp.currentSpeed - 10)

        if label then
            label.Text = tostring(math.floor(trimp.currentSpeed * 10) / 10)
        end
    end

    trimp.wasAir = isInAir

    if isInAir then
        trimp.airAccumulator = trimp.airAccumulator + deltaTime

        while trimp.airAccumulator >= 0.04 do
            trimp.airAccumulator = trimp.airAccumulator - 0.04
            trimp.currentSpeed = math.min(base + TRIMP_MAX_EXTRA, trimp.currentSpeed + 0.1)
        end
    else
        trimp.airAccumulator = 0
        trimp.currentSpeed = math.max(base, trimp.currentSpeed - 4 * deltaTime)
    end

    if trimp.activeBV then
        trimp.activeBV:Destroy()
        trimp.activeBV = nil
    end

    local direction = flatLook()

    if not direction then
        return
    end

    local velocity = Instance.new("BodyVelocity")
    velocity.Velocity = direction * trimp.currentSpeed
    velocity.MaxForce = Vector3.new(400000, 0, 400000)
    velocity.P = 1250
    velocity.Parent = root

    debris:AddItem(velocity, 0.1)
    trimp.activeBV = velocity

    if label then
        label.Text = tostring(math.floor(trimp.currentSpeed * 10) / 10)
    end
end

defineFeature("AutoTrimp", "AutoTrimpEnabled", "Auto Trimp", function(isEnabled)
    if isEnabled then
        trimp.currentSpeed = S.AutoTrimpSpeed
        trimp.lastTick = tick()

        if not trimp.connection then
            trimp.connection = runService.RenderStepped:Connect(updateAutoTrimp)
        end
    else
        stopAutoTrimp()
    end
end)

