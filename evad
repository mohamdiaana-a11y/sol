            end
        end

        if type(window.ToggleInterface) == "function" then
            local originalToggle = window.ToggleInterface

            window.ToggleInterface = function(self, ...)
                if window.Destroyed then
                    return
                end

                local isOpen = window.Signal and window.Signal:GetValue()

                if not isOpen then
                    pcall(function()
                        if window.Root and modern.ScreenGui then
                            window.Root.Parent = modern.ScreenGui
                            window.Root.Visible = true
                        end
                    end)
                end

                return originalToggle(self, ...)
