-- ---- Auto Escape (Anti-Bot) ----
-- Bot = model di workspace.Players dengan atribut AI = true.
-- Jika ada bot dalam jarak tertentu, karakter teleport ke salah satu ItemSpawns.
loop(0.1, function()
    if not S.AutoEscapeEnabled then
        return
    end

    local _, _, root = getCharacterParts()
    local playersFolder = workspace:FindFirstChild("Players")
    local mapFolder = workspace:FindFirstChild("Map")
    local itemSpawns = mapFolder and mapFolder:FindFirstChild("ItemSpawns")

    if not root or not playersFolder or not itemSpawns then
        return
    end

    for _, aiModel in ipairs(playersFolder:GetChildren()) do
        local aiRoot = aiModel:GetAttribute("AI") == true and aiModel:FindFirstChild("HumanoidRootPart")

        if aiRoot and (root.Position - aiRoot.Position).Magnitude < S.AutoEscapeDistance then
            local spawns = itemSpawns:GetChildren()

            if #spawns > 0 then
                root.CFrame = spawns[math.random(1, #spawns)].CFrame
                task.wait(0.5)
                return
            end
        end
    end
end)

