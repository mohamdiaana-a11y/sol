local emoteSpeed = getgenv().EmoteSpeedSettings or {
    SpeedValue = 1500,
    Mode = "Nonaktif",
    OriginalSpeeds = {},
    AppliedToUnwalkable = false,
    LastAppliedValue = 0,
}

getgenv().EmoteSpeedSettings = emoteSpeed

local emoteModulesFolder = nil

do
    local items = replicatedStorage:FindFirstChild("Items")
    emoteModulesFolder = items and items:FindFirstChild("Emotes")

    if emoteModulesFolder and not next(emoteSpeed.OriginalSpeeds) then
        for _, emoteModule in ipairs(emoteModulesFolder:GetChildren()) do
            if emoteModule:IsA("ModuleScript") then
                local requireSuccess, data = pcall(require, emoteModule)

                if requireSuccess and data and data.EmoteInfo then
                    emoteSpeed.OriginalSpeeds[emoteModule.Name] = data.EmoteInfo.SpeedMult
                end
            end
        end
    end
end

local function forEachEmoteInfo(callback)
    if not emoteModulesFolder then
        return
    end

    for _, emoteModule in ipairs(emoteModulesFolder:GetChildren()) do
        if emoteModule:IsA("ModuleScript") then
            local requireSuccess, data = pcall(require, emoteModule)

            if requireSuccess and data and data.EmoteInfo then
                callback(emoteModule, data.EmoteInfo)
            end
        end
    end
end

local function applyEmoteSpeedAll(speedMult)
    emoteSpeed.LastAppliedValue = speedMult

    forEachEmoteInfo(function(_, info)
        if info.SpeedMult ~= 0 then
            info.SpeedMult = speedMult
        end
    end)
end

local function resetEmoteSpeed()
    forEachEmoteInfo(function(emoteModule, info)
        local originalSpeed = emoteSpeed.OriginalSpeeds[emoteModule.Name]

        if originalSpeed then
            info.SpeedMult = originalSpeed
        end
    end)
end

local function applyWalkSpeedMultiplier(multiplier)
    for _, statsTable in ipairs(findMovementStatsTables()) do
        pcall(function() statsTable.WalkSpeedMultiplier = multiplier end)
    end
end

local watchedEmotePlayer = nil
local emoteStateConnection = nil

local function getLocalPlayerModel()
    local gameFolder = workspace:FindFirstChild("Game")
    local playersFolder = gameFolder and gameFolder:FindFirstChild("Players")

    return playersFolder and playersFolder:FindFirstChild(localPlayer.Name)
end

local function currentEmoteMultiplier(playerModel)
    if playerModel:GetAttribute("State") == "Emoting" then
        return emoteSpeed.SpeedValue / 1000
    end

    return 1.5
end

local function watchEmoteSpeedPlayer(playerModel)
    if emoteStateConnection then
        emoteStateConnection:Disconnect()
        emoteStateConnection = nil
    end

    watchedEmotePlayer = playerModel

    if not playerModel then
        return
    end

    applyWalkSpeedMultiplier(currentEmoteMultiplier(playerModel))

    emoteStateConnection = playerModel:GetAttributeChangedSignal("State"):Connect(function()
        applyWalkSpeedMultiplier(currentEmoteMultiplier(playerModel))
    end)
end

local function resetWalkSpeedMultiplier()
    applyWalkSpeedMultiplier(1.5)
end

do
    local section = ui:Section("Emote Speed")

    section:AddDropdown({
        Title = "Emote Speed Mode",
        Description = "Nonaktif / Legit (ubah data emote) / Multiplier (ubah WalkSpeedMultiplier saat emote)",
        Options = { "Nonaktif", "Legit", "Multiplier" },
        Default = emoteSpeed.Mode,
        Callback = function(value)
            emoteSpeed.Mode = value

            if value == "Nonaktif" then
                resetWalkSpeedMultiplier()
                resetEmoteSpeed()

                if emoteStateConnection then
                    emoteStateConnection:Disconnect()
                    emoteStateConnection = nil
                end
            elseif value == "Multiplier" then
                resetEmoteSpeed()
                watchEmoteSpeedPlayer(getLocalPlayerModel())

                task.spawn(function()
                    while alive and emoteSpeed.Mode == "Multiplier" do
                        task.wait(2)

                        local currentPlayerModel = getLocalPlayerModel()

                        if currentPlayerModel ~= watchedEmotePlayer then
                            watchEmoteSpeedPlayer(currentPlayerModel)
                        elseif watchedEmotePlayer then
                            applyWalkSpeedMultiplier(currentEmoteMultiplier(watchedEmotePlayer))
                        end
                    end
                end)
            elseif value == "Legit" then
                resetWalkSpeedMultiplier()

                if emoteStateConnection then
                    emoteStateConnection:Disconnect()
                    emoteStateConnection = nil
                end

                applyEmoteSpeedAll(emoteSpeed.SpeedValue / 1000)
            end
        end,
    })

    section:AddSlider({
        Title = "Emote Speed Value",
        Description = "Nilai kecepatan emote (dibagi 1000 jadi multiplier)",
        Min = 100, Max = 10000, Default = emoteSpeed.SpeedValue, Increment = 50,
        Callback = function(value)
            emoteSpeed.SpeedValue = value

            if emoteSpeed.Mode == "Legit" then
                applyEmoteSpeedAll(value / 1000)
            elseif emoteSpeed.Mode == "Multiplier" and watchedEmotePlayer then
                if watchedEmotePlayer:GetAttribute("State") == "Emoting" then
                    applyWalkSpeedMultiplier(value / 1000)
                end
            end
        end,
    })

    section:AddButton({
        Title = "Apply to Unwalkable Emotes",
        Description = "Terapkan ke emote yang tidak bisa bergerak",
        Callback = function()
            local speedMult = emoteSpeed.SpeedValue / 1000

            forEachEmoteInfo(function(_, info)
                if info.SpeedMult == 0 then
                    info.SpeedMult = speedMult
                end
            end)

            emoteSpeed.AppliedToUnwalkable = true

            uiLibrary:Notify({
                Title = "Emote Speed",
                Content = "Berhasil terapkan ke emote yang tidak bisa bergerak",
                Type = "Success",
                Duration = 3,
            })
        end,
    })

    section:AddButton({
        Title = "Reset Emote Speed",
        Description = "Reset kecepatan ke default",
        Callback = function()
            resetEmoteSpeed()
            resetWalkSpeedMultiplier()

            emoteSpeed.AppliedToUnwalkable = false
            emoteSpeed.LastAppliedValue = 0

            uiLibrary:Notify({
                Title = "Emote Speed",
                Content = "Semua kecepatan emote telah direset",
                Duration = 3,
            })
        end,
    })
end

