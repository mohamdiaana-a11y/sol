                        end
                    end,
                })
            end)

            handle.Instance = didAdd and instance or nil
            attachTip(handle.Instance, title, cfg.Description)

            function handle:Get()
                return handle.Value
            end

            return handle
        end

        return section
    end

    local function buildTab(window, tabName)
        local didAdd, tab = pcall(function()
            return window:AddTab({ Name = tabName, Icon = TAB_ICONS[tabName] or "lucide:layers", Type = "Single" })
        end)

        assert(didAdd and tab, "Gagal membuat tab: " .. tostring(tabName))

        local homes = {}

        for _, group in ipairs(LAYOUT[tabName] or {}) do
            local didBox, tabbox = pcall(function() return tab:AddCenterTabbox(group.Group) end)

            if didBox and tabbox then
                for _, sub in ipairs(group.Subs) do
                    local didSub, subTab = pcall(function()
                        return tabbox:AddTab({ Name = sub.Name, Icon = sub.Icon })
                    end)

                    if didSub and subTab then
                        for _, sectionName in ipairs(sub.Sections) do
                            homes[sectionName] = subTab
                        end
                    else
                        warn("[Solana Hub] Gagal membuat sub-tab " .. sub.Name .. ": " .. tostring(subTab))
                    end
                end
            else
                warn("[Solana Hub] Gagal membuat tabbox " .. group.Group .. ": " .. tostring(tabbox))
            end
        end

        return { Raw = tab, Homes = homes }
    end

