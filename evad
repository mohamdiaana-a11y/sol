-- ---- Layer Jumps ----
local layerJumpsInstance = nil
local originalJumpCap = nil

local function findLayerJumpsInstance()
    if layerJumpsInstance then
        return layerJumpsInstance
    end

    local success, gcObjects = pcall(getgc, true)

    if not success or not gcObjects then
        return nil
    end

    for i = 1, #gcObjects do
        local object = gcObjects[i]

        if type(object) == "table" then
            local ok, moveStats = pcall(rawget, object, "MoveStats")

            if ok and type(moveStats) == "table" then
                local ok2, jumpCap = pcall(rawget, moveStats, "JumpCap")

                if ok2 and type(jumpCap) == "number" then
                    layerJumpsInstance = object
                    return object
                end
            end
        end
    end

    return nil
end

local function applyLayerJumps()
    if not S.LayerJumpsEnabled then
        if layerJumpsInstance and originalJumpCap then
            pcall(function()
                local moveStats = rawget(layerJumpsInstance, "MoveStats")

                if type(moveStats) == "table" then
                    moveStats.JumpCap = originalJumpCap
                end
            end)

            originalJumpCap = nil
        end

        return
    end

    local instance = findLayerJumpsInstance()

    if not instance then
        return
    end

    pcall(function()
        local moveStats = rawget(instance, "MoveStats")

        if type(moveStats) == "table" and type(moveStats.JumpCap) == "number" then
            if not originalJumpCap then
                originalJumpCap = moveStats.JumpCap ~= S.LayerJumpsCount and moveStats.JumpCap or 1
            end

            moveStats.JumpCap = S.LayerJumpsCount
        end
    end)
end

defineFeature("Layer Jumps", "LayerJumpsEnabled", "Layer Jumps", function(isEnabled)
    if not isEnabled then
        applyLayerJumps() -- kembalikan JumpCap asli
    end
end)

