unload = function()
    if not alive then
        return
    end

    for _, name in ipairs(FeatureOrder) do
        setFeature(name, false)
    end

    alive = false

    S.AutoEscapeEnabled = false
    S.AutoTicketEnabled = false
    S.VoidEscapeEnabled = false
    S.AutoForceSpawnEnabled = false
    S.PlayerESPEnabled = false
    _G.ESP_Active = false

    stopVisualEmote()
    resetEmoteState()
    disconnectAll(characterWatcherConnections)
    disconnectAll(humanoidWatcherConnections)

    if emoteSpeed.Mode ~= "Nonaktif" then
        emoteSpeed.Mode = "Nonaktif"
        resetWalkSpeedMultiplier()
        resetEmoteSpeed()
    end

    if emoteStateConnection then
        emoteStateConnection:Disconnect()
        emoteStateConnection = nil
    end

    if espClearAll then
        espClearAll()
    end

    for _, connection in ipairs(connections) do
        pcall(function() connection:Disconnect() end)
    end

    for _, connection in pairs(KeybindConnections) do
        pcall(function() connection:Disconnect() end)
    end

    for _, gui in ipairs(floatingGuis) do
        pcall(function() gui:Destroy() end)
    end

    getgenv().SolanaHubEvade = nil
    getgenv().FeatureStates = nil

    uiLibrary:Destroy()
end

