do
    local hookedCrouchButton = nil

    local function findCrouchButton()
        local current = playerGui

        for _, pathPart in ipairs({ "Shared", "HUD", "Mobile", "Right", "Mobile", "CrouchButton" }) do
            current = current:FindFirstChild(pathPart)

            if not current then
                return nil
            end
        end

        return current
    end

    loop(1, function()
        local button = findCrouchButton()

        if not button or button == hookedCrouchButton then
            return
        end

        hookedCrouchButton = button

        local isHolding = false
        local holdTask = nil

        button.MouseButton1Down:Connect(function()
            isHolding = true

            holdTask = task.delay(0.5, function()
                if isHolding and S.EmoteEnabled and S.SelectedEmote then
                    pcall(function()
                        replicatedStorage.Events.Character.Emote:FireServer(S.SelectedEmote)
                    end)
                end
            end)
        end)

        button.MouseButton1Up:Connect(function()
            isHolding = false

            if holdTask then
                task.cancel(holdTask)
                holdTask = nil
            end
        end)
    end)
end

