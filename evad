    -- Patch kecil untuk ModernV2: tinggi panel AddParagraph diukur dari teks tanpa tag rich text.
    local function patchLibrarySource(source)
        if type(source) ~= "string" then
            return source
        end

        local needle = "local ContentSize = TextService:GetTextSize(ContentLabel.Text,ContentLabel.TextSize,ContentLabel.Font,Vector2.new(Width,math.huge));"

        local replacement = [[local PlainText = ContentLabel.Text
			if ContentLabel.RichText then
				PlainText = PlainText:gsub("<[^>]*>", ""):gsub("&lt;", "<"):gsub("&gt;", ">"):gsub("&amp;", "&")
			end
			local ContentSize = TextService:GetTextSize(PlainText,ContentLabel.TextSize,ContentLabel.Font,Vector2.new(math.max(60, Width - 12),math.huge));]]

        local startIndex, endIndex = string.find(source, needle, 1, true)

        if not startIndex then
            return source
        end

        return string.sub(source, 1, startIndex - 1) .. replacement .. string.sub(source, endIndex + 1)
    end

