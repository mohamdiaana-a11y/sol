    end

    local humanoid = rig:FindFirstChildOfClass("Humanoid")
    local humanoidAnimator = humanoid and humanoid:FindFirstChildOfClass("Animator")
    local animationController = rig:FindFirstChildOfClass("AnimationController")

    return humanoidAnimator, animationController and animationController:FindFirstChildOfClass("Animator")
end

