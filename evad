-- ---- Graphics ----
local function applyPotatoMode()
    if not S.PotatoEnabled then
        return
    end

    for _, descendant in ipairs(game:GetDescendants()) do
        if descendant:IsA("Part") or descendant:IsA("MeshPart") then
            descendant.Material = Enum.Material.SmoothPlastic
        elseif descendant:IsA("Decal") or descendant:IsA("Texture") then
            descendant.Transparency = 1
        end
    end
end

local function applyNoFog()
    if S.NoFogEnabled then
        lighting.FogEnd = 100000

        local atmosphere = lighting:FindFirstChildOfClass("Atmosphere")

        if atmosphere then
            atmosphere.Density = 0
        end
    else
        lighting.FogEnd = 2500
    end
end

local function applyFullbright()
    if S.FullbrightEnabled then
        lighting.Ambient = Color3.fromRGB(255, 255, 255)
        lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        lighting.ExposureCompensation = 1
    else
        lighting.Ambient = Color3.fromRGB(0, 0, 0)
        lighting.ExposureCompensation = 0
    end
end

defineFeature("Potato", "PotatoEnabled", "Potato Mode", function() applyPotatoMode() end)
defineFeature("No Fog", "NoFogEnabled", "No Fog", function() applyNoFog() end)
defineFeature("Fullbright", "FullbrightEnabled", "Fullbright", function() applyFullbright() end)

-- game bisa mengembalikan lighting sendiri, jadi diterapkan ulang tiap 60 detik
loop(60, function()
    if S.PotatoEnabled or S.NoFogEnabled or S.FullbrightEnabled then
        applyPotatoMode()
