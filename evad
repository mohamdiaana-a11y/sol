-- ---- Infinite Slide ----
local slideState = { inSlide = false, slideDir = Vector3.new(0, 0, 1) }
local activeSlideVelocity = nil
local slideConnection = nil
local slideKeys = { Enum.KeyCode.LeftControl, Enum.KeyCode.C }

local function clearSlide()
    slideState.inSlide = false

    if activeSlideVelocity then
        activeSlideVelocity:Destroy()
        activeSlideVelocity = nil
    end
end

local function isSlideKeyPressed()
    if userInputService.KeyboardEnabled then
        for _, key in ipairs(slideKeys) do
            if userInputService:IsKeyDown(key) then
                return true
            end
        end

        return false
    end

    if userInputService.GamepadEnabled then
        local success, isPressed = pcall(function()
            return userInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonR2)
        end)

        if success then
            return isPressed
        end
    end

    return nil
end

local function getSlideDirection(character, root)
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        local move = humanoid.MoveDirection
        local flat = Vector3.new(move.X, 0, move.Z)

        if flat.Magnitude > 0.1 then
            return flat.Unit
        end
    end

    local look = flatLook()

    if look and look.Magnitude > 0.1 then
        return look
    end

    local velocity = root.AssemblyLinearVelocity
    local flatVelocity = Vector3.new(velocity.X, 0, velocity.Z)

    if flatVelocity.Magnitude > 0.1 then
        return flatVelocity.Unit
    end

    return slideState.slideDir
end

local function updateInfiniteSlide()
    local character, _, root = getCharacterParts()
    local slideFolder = root and root:FindFirstChild("Slide")
    local slideSound = slideFolder and slideFolder:FindFirstChild("SlideSound")

    if not character or not root or not slideSound then
        clearSlide()
        return
    end

    if slideSound.Playing then
        if not slideState.inSlide then
            slideState.inSlide = true
            local velocity = root.AssemblyLinearVelocity
            local flatVelocity = Vector3.new(velocity.X, 0, velocity.Z)

            if flatVelocity.Magnitude > 0.1 then
                slideState.slideDir = flatVelocity.Unit
            end
        end
    elseif not slideState.inSlide then
        clearSlide()
        return
    end

    local isKeyHeld = isSlideKeyPressed()

    if isKeyHeld == false or isKeyHeld == nil and not slideSound.Playing then
        clearSlide()
        return
    end

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { character }

    local result = workspace:Raycast(root.Position, Vector3.new(0, -4, 0), rayParams)
    local normal = result and result.Normal or Vector3.new(0, 1, 0)

    slideState.slideDir = getSlideDirection(character, root)

    local slideDir = slideState.slideDir
    local projected = slideDir - normal * slideDir:Dot(normal)

    if projected.Magnitude > 0.01 then
        projected = projected.Unit
    else
        projected = slideDir
    end

    if activeSlideVelocity then
        activeSlideVelocity:Destroy()
    end

    local velocity = Instance.new("BodyVelocity")
    velocity.Velocity = projected * S.InfiniteSlideSpeed
    velocity.MaxForce = Vector3.new(400000, 400000, 400000)
    velocity.P = 10000
    velocity.Parent = root

    debris:AddItem(velocity, 0.1)
    activeSlideVelocity = velocity
end

defineFeature("Inf Slide", "InfiniteSlide", "Infinite Slide", function(isEnabled)
    if isEnabled then
        if not slideConnection then
            slideConnection = runService.Heartbeat:Connect(updateInfiniteSlide)
        end
    else
        clearSlide()

        if slideConnection then
            slideConnection:Disconnect()
            slideConnection = nil
        end
    end
end)

