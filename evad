local espClearAll

do
    local rigServiceModule = nil
    local whistleHighlightTemplate = nil
    local espEntries = {}
    local defaultHighlightColor = Color3.fromRGB(255, 255, 255)
    local downedHighlightColor = Color3.fromRGB(255, 70, 70)

    task.spawn(function()
        pcall(function()
            local servicesFolder = replicatedStorage:WaitForChild("Services", 5)
            local assetFolder = servicesFolder and servicesFolder:WaitForChild("Asset", 5)
            local rigServiceFolder = assetFolder and assetFolder:WaitForChild("RigService", 5)

            if rigServiceFolder then
                rigServiceModule = require(rigServiceFolder)
            end
        end)

        pcall(function()
            local objectsFolder = replicatedStorage:WaitForChild("Objects", 5)
            local gameFolder = objectsFolder and objectsFolder:WaitForChild("Game", 5)
            local characterFolder = gameFolder and gameFolder:WaitForChild("Character", 5)
            local actionVisualsFolder = characterFolder and characterFolder:WaitForChild("ActionVisuals", 5)
            local actionsFolder = actionVisualsFolder and actionVisualsFolder:WaitForChild("Actions", 5)
            local whistleFolder = actionsFolder and actionsFolder:WaitForChild("Whistle", 5)
            whistleHighlightTemplate = whistleFolder and whistleFolder:FindFirstChild("WhistleHighlight")
        end)
    end)

    local function safeDisconnect(connection)
        if connection then
            pcall(function() connection:Disconnect() end)
        end
    end

    local function updateEspHighlight(entry)
        if not entry or not entry.highlight then
            return
        end

        local targetColor = entry.downed and downedHighlightColor or defaultHighlightColor

        pcall(function()
            entry.highlight.FillColor = targetColor
            entry.highlight.OutlineColor = targetColor
        end)
    end

    local function cleanupEspEntry(entry)
        if not entry then
            return
        end

        safeDisconnect(entry.died)
        entry.died = nil

        if entry.highlight then
            pcall(function() entry.highlight:Destroy() end)
            entry.highlight = nil
        end

        if entry.billboard then
            pcall(function() entry.billboard:Destroy() end)
            entry.billboard = nil
        end

        entry.label = nil
        entry.root = nil
        entry.visualRoot = nil
        entry.visualModel = nil
        entry.rigData = nil
        entry.downed = false
        entry.humanoid = nil
        entry.character = nil
    end

    local function removePlayerEsp(player)
        local entry = espEntries[player]

        if not entry then
            return
        end

        safeDisconnect(entry.characterAdded)
        safeDisconnect(entry.characterRemoving)

        cleanupEspEntry(entry)
        espEntries[player] = nil
    end

    local function getRigFromTag(character)
        if not rigServiceModule or not character then
            return nil
        end

        local tag = character:GetAttribute("Tag")

        if not tag then
            return nil
        end

        local success, rigData = pcall(function() return rigServiceModule:GetRigFromTag(tag) end)

        if success and rigData and rigData.Model and rigData.Model:IsA("Model") then
            return rigData
        end

        return nil
    end

    local function resolveVisualModel(player, character)
        local rigData = getRigFromTag(character)
        local model = rigData and rigData.Model or nil

        if model then
            local rootPart = model:FindFirstChild("HumanoidRootPart", true)
                or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)

            if rootPart then
                return model, rootPart, rigData
            end
        end

        local playersFolder = workspace:FindFirstChild("Players")
        model = playersFolder and playersFolder:FindFirstChild(player.Name)

        if model and model:IsA("Model") then
            local rootPart = model:FindFirstChild("HumanoidRootPart", true)
                or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)

            if rootPart then
                return model, rootPart, nil
            end
        end

        return character, character and character:FindFirstChild("HumanoidRootPart"), nil
    end

    local function isPlayerDowned(rigData, character)
        if rigData and rigData.DataRegistry then
            local success, value = pcall(function() return rigData.DataRegistry:Get("Downed") end)

            if success and value == true then
                return true
            end

            local success2, state = pcall(function() return rigData.DataRegistry:Get("State") end)

            if success2 and state == "Downed" then
                return true
            end
        end

        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        return humanoid ~= nil and humanoid.Health <= 0
    end

    local function buildPlayerEsp(player, character)
        if player == localPlayer then
            return
        end

        local entry = espEntries[player]

        if not entry then
            entry = {}
            espEntries[player] = entry
        else
            cleanupEspEntry(entry)
        end

        local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if not character or not humanoidRootPart or not humanoid then
            return
        end

        local visualModel, visualRoot, rigData = resolveVisualModel(player, character)

        if not visualModel or not visualRoot then
            return
        end

        local existingHighlight = character:FindFirstChild("SolanaHub_PlayerESP_Highlight")

        if existingHighlight then
            existingHighlight:Destroy()
        end

        local existingLabel = visualRoot:FindFirstChild("SolanaHub_PlayerESP_Label")

        if existingLabel then
            existingLabel:Destroy()
        end

        local espHighlight

        if whistleHighlightTemplate then
            espHighlight = whistleHighlightTemplate:Clone()
        else
            espHighlight = Instance.new("Highlight")
            espHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            espHighlight.FillTransparency = 1
            espHighlight.OutlineTransparency = 0
        end

        espHighlight.Name = "SolanaHub_PlayerESP_Highlight"
        espHighlight.Adornee = visualModel
        espHighlight.Enabled = S.PlayerESPEnabled
        espHighlight.Parent = character

        local espBillboard = Instance.new("BillboardGui")
        espBillboard.Name = "SolanaHub_PlayerESP_Label"
        espBillboard.Adornee = visualRoot
        espBillboard.AlwaysOnTop = true
        espBillboard.LightInfluence = 0

        pcall(function() espBillboard.MaxDistance = math.huge end)

        espBillboard.Size = UDim2.new(0, 360, 0, 42)
        espBillboard.StudsOffset = Vector3.new(0, 3.8, 0)
        espBillboard.Enabled = S.PlayerESPEnabled
        espBillboard.Parent = visualRoot

        local infoLabel = Instance.new("TextLabel")
        infoLabel.Name = "Info"
        infoLabel.BackgroundTransparency = 1
        infoLabel.Size = UDim2.new(1, 0, 1, 0)
        infoLabel.Font = Enum.Font.GothamBold
        infoLabel.TextColor3 = defaultHighlightColor
        infoLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
        infoLabel.TextStrokeTransparency = 0
        infoLabel.TextSize = 18
        infoLabel.TextXAlignment = Enum.TextXAlignment.Center
        infoLabel.TextYAlignment = Enum.TextYAlignment.Center
        infoLabel.Text = player.DisplayName
        infoLabel.Parent = espBillboard

        entry.character = character
        entry.root = humanoidRootPart
        entry.visualModel = visualModel
        entry.visualRoot = visualRoot
        entry.rigData = rigData
        entry.downed = isPlayerDowned(rigData, character)
        entry.humanoid = humanoid
        entry.highlight = espHighlight
        entry.billboard = espBillboard
        entry.label = infoLabel

        updateEspHighlight(entry)

        entry.died = humanoid.Died:Connect(function()
            if espEntries[player] == entry then
                entry.downed = true
                updateEspHighlight(entry)
            end
        end)
    end

    local function watchPlayerEsp(player)
        if player == localPlayer then
            return
        end

        removePlayerEsp(player)

        espEntries[player] = {
            characterAdded = player.CharacterAdded:Connect(function(character)
                task.defer(function()
                    if S.PlayerESPEnabled and character:WaitForChild("HumanoidRootPart", 5)
                        and character:FindFirstChildOfClass("Humanoid") then
                        buildPlayerEsp(player, character)
                    end
                end)
            end),
            characterRemoving = player.CharacterRemoving:Connect(function()
                cleanupEspEntry(espEntries[player])
            end),
        }

        if player.Character then
            buildPlayerEsp(player, player.Character)
        end
    end

    espClearAll = function()
        for player in pairs(espEntries) do
            removePlayerEsp(player)
        end
    end

    track(players.PlayerAdded:Connect(function(player)
        if S.PlayerESPEnabled then
            watchPlayerEsp(player)
        end
    end))

    track(players.PlayerRemoving:Connect(removePlayerEsp))

    -- update jarak & status downed tiap 0.1 detik
    loop(0.1, function()
        if not S.PlayerESPEnabled then
            return
        end

        local _, _, localRoot = getCharacterParts()

        for player, entry in pairs(espEntries) do
            if entry.label and entry.visualRoot and entry.visualRoot.Parent then
                local text = player.DisplayName

                if localRoot then
                    text = text .. " [" .. math.floor((entry.visualRoot.Position - localRoot.Position).Magnitude) .. "m]"
                end

                entry.downed = isPlayerDowned(entry.rigData, entry.character)
                entry.label.Text = text
                updateEspHighlight(entry)
            end
        end
    end)

    local section = ui:Section("Player ESP")

    section:AddToggle({
        Title = "Player ESP",
        Description = "Highlight nama & jarak pemain (merah saat downed)",
        Default = false,
        Callback = function(value)
            S.PlayerESPEnabled = value

            if value then
                for _, player in ipairs(players:GetPlayers()) do
                    watchPlayerEsp(player)
                end
            else
                espClearAll()
            end
        end,
    })
end

