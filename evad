local frontJumpVelocity = nil

local function stopFrontJump()
    if frontJumpVelocity then
        frontJumpVelocity:Destroy()
        frontJumpVelocity = nil
    end
end

local function startFrontJump()
    stopFrontJump()

    local character, humanoid, root = getCharacterParts()

    if not humanoid or not root then
        return
    end

    local velocity = Instance.new("BodyVelocity")
    velocity.MaxForce = Vector3.new(400000, 0, 400000)
    velocity.P = 1250
    velocity.Velocity = Vector3.new(0, 0, 0)
    velocity.Parent = root
    frontJumpVelocity = velocity

    task.spawn(function()
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = { character }

        while alive and S.FrontJumpEnabled and frontJumpVelocity == velocity and velocity.Parent do
            local direction = flatLook()

            if direction then
                velocity.Velocity = direction * S.FrontJumpSpeed

                if S.FrontAutoJumpEnabled and humanoid:GetState() ~= Enum.HumanoidStateType.Jumping
                    and workspace:Raycast(root.Position, Vector3.new(0, -4, 0), rayParams) then
                    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end

            task.wait(0.016)
        end

        if frontJumpVelocity == velocity then
            stopFrontJump()
        end
    end)
end

