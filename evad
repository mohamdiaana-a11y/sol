            end)

            handle.Instance = didAdd and instance or nil
            attachTip(handle.Instance, title, cfg.Description)

            function handle:Get()
                return handle.Value
            end

            return handle
        end

        function section:AddSlider(cfg)
            header()

            local title = stripTags(cfg.Title)
            local increment = tonumber(cfg.Increment) or 1
            local rounding = 0

            if increment < 1 then
                rounding = increment <= 0.01 and 2 or 1
            end

            local unit = ""

            if cfg.Unit == "%" then
                unit = "%"
            elseif cfg.Unit then
                unit = " " .. tostring(cfg.Unit)
            end

            local handle = { Value = cfg.Default or cfg.Min or 0 }

            local didAdd, instance = pcall(function()
                return host:AddSlider({
                    Name = title,
                    Min = cfg.Min or 0,
                    Max = cfg.Max or 100,
                    Default = handle.Value,
                    Increment = increment,
                    Rounding = rounding,
                    Type = unit,
                    Flag = makeFlag("S", sectionName, title),
                    Callback = function(value)
                        handle.Value = value

                        if type(cfg.Callback) == "function" then
                            task.spawn(pcall, cfg.Callback, value)
                        end
                    end,
                })
            end)

            handle.Instance = didAdd and instance or nil
            attachTip(handle.Instance, title, cfg.Description)

            function handle:Get()
