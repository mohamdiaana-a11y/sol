-- Registry fitur: satu sumber kebenaran untuk toggle UI, tombol floating, dan keybind
-- ---------------------------------------------------------------------------
local Features = {}
local FeatureOrder = {}
local floatingEnabled = true
local floatingGuis = {}
local createFloating

local function syncFeature(feature)
    local value = S[feature.Key] == true

    if feature.Ui then
        feature.Ui:Set(value)
    end

    if feature.NoFloat then
        return
    end

    if value and not feature.Float then
        feature.Float = createFloating(feature)
    end

    if feature.Float then
        feature.Float.Gui.Enabled = floatingEnabled
        feature.Float.Update(value)
    end
end

local function setFeature(name, value)
    local feature = Features[name]

    if not feature then
        return
    end

    value = value == true

    if S[feature.Key] == value then
        return
    end

    S[feature.Key] = value

    if feature.OnChange then
        local ok, err = pcall(feature.OnChange, value)

        if not ok then
            warn("[Solana Hub] " .. name .. ": " .. tostring(err))
        end
    end

    syncFeature(feature)
end

local function defineFeature(name, key, title, onChange, noFloat)
    local feature = {
        Name = name,
        Key = key,
        Title = title,
